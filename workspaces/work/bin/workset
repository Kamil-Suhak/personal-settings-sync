#!/usr/bin/env python3
"""Manage named cross-repository issue file sets ('worksets')."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import uuid
from pathlib import Path

BIN_COMMON_DIR = Path(__file__).resolve().parents[3] / "configs" / "bin"
SCRIPTS_DIR = Path(__file__).resolve().parents[3] / "scripts"
sys.path.insert(0, str(BIN_COMMON_DIR))
sys.path.insert(0, str(SCRIPTS_DIR))

from _pss_common import (  # noqa: E402
    ctext,
    normalize_legacy_flags,
    read_config_lines,
    resolve_project_roots_file,
    resolve_pss_root,
    resolve_state_home,
    run_git,
)
from local_state import get_local_state_paths  # noqa: E402

RESERVED_WIN_RE = re.compile(r"^(con|prn|aux|nul|com[1-9]|lpt[1-9])(\.|$)", re.IGNORECASE)
VALID_ACTIONS = ("new", "add", "rm", "edit", "show", "list", "open", "archive", "restore", "delete")


def convert_to_workset_name(name: str) -> str:
    """Normalize a workset identifier into a safe directory name."""
    step1 = re.sub(r"[^a-z0-9._-]+", "-", name.strip().lower())
    normalized = re.sub(r"-+", "-", step1).strip(" .-")
    if not normalized or len(normalized) > 100 or RESERVED_WIN_RE.match(normalized):
        raise ValueError(f"Invalid workset name '{name}'; choose a valid name up to 100 characters.")
    return normalized


def resolve_worksets_root() -> Path:
    env_root = os.environ.get("PSS_WORKSETS_ROOT")
    if env_root:
        return Path(env_root).expanduser()
    paths = get_local_state_paths(resolve_pss_root(), state_home=resolve_state_home())
    return paths["worksets_root"]


def get_workset_context(directory: Path | None = None) -> tuple[str, str | None] | None:
    target = directory or Path.cwd()
    root_res = run_git(["rev-parse", "--show-toplevel"], cwd=target)
    if root_res.returncode != 0 or not root_res.stdout.strip():
        return None
    root_path = str(Path(root_res.stdout.strip()).resolve())
    branch_res = run_git(["symbolic-ref", "--quiet", "--short", "HEAD"], cwd=target)
    branch = branch_res.stdout.strip() if branch_res.returncode == 0 and branch_res.stdout.strip() else None
    return root_path, branch


def get_workset_dir(name: str, *, archived: bool = False) -> Path:
    sub = "archived" if archived else "active"
    return resolve_worksets_root() / sub / convert_to_workset_name(name)


def _repo_matches(meta: dict, root: str, branch: str) -> bool:
    if meta.get("originRoot") == root and meta.get("branch") == branch:
        return True
    for repo in meta.get("repositories") or []:
        if isinstance(repo, dict) and repo.get("root") == root and repo.get("branch") == branch:
            return True
    return False


def find_matching_worksets(root: str, branch: str, *, archived: bool = False) -> list[Path]:
    if not root or not branch:
        return []
    sub = "archived" if archived else "active"
    parent = resolve_worksets_root() / sub
    if not parent.is_dir():
        return []
    matches: list[Path] = []
    for entry in sorted(parent.iterdir(), key=lambda p: p.name.lower()):
        if not entry.is_dir() or entry.name.startswith(".new-"):
            continue
        meta_path = entry / "metadata.json"
        if not meta_path.is_file():
            continue
        try:
            meta = json.loads(meta_path.read_text(encoding="utf-8", errors="replace"))
        except json.JSONDecodeError:
            continue
        if _repo_matches(meta, root, branch):
            matches.append(entry)
    return matches


def _count_workset_entries(ws_dir: Path) -> int:
    list_file = ws_dir / "files.txt"
    if not list_file.is_file():
        return 0
    return sum(
        1
        for raw in list_file.read_text(encoding="utf-8", errors="replace").splitlines()
        if raw.strip() and not raw.strip().startswith("#")
    )


def get_current_workset_name(root: str, branch: str) -> str | None:
    if not root or not branch or branch.startswith(":"):
        return None
    matches = find_matching_worksets(root, branch, archived=False)
    if len(matches) == 1:
        return matches[0].name
    return None


def get_current_workset_badge(root: str, branch: str) -> str | None:
    """Return compact Starship badge: `✦N` when name matches branch, else `<name> ✦N`."""
    if not root or not branch or branch.startswith(":"):
        return None
    matches = find_matching_worksets(root, branch, archived=False)
    if len(matches) != 1:
        return None
    ws_dir = matches[0]
    count = _count_workset_entries(ws_dir)
    try:
        branch_norm = convert_to_workset_name(branch)
    except ValueError:
        branch_norm = ""
    if ws_dir.name == branch_norm:
        return f"✦{count}"
    return f"{ws_dir.name} ✦{count}"


def _select_workset_with_fzf(*, archived: bool = False) -> Path | None:
    if not sys.stdin.isatty() or not shutil.which("fzf"):
        return None
    sub = "archived" if archived else "active"
    parent = resolve_worksets_root() / sub
    if not parent.is_dir():
        return None
    names = [
        entry.name
        for entry in sorted(parent.iterdir(), key=lambda p: p.name.lower())
        if entry.is_dir() and not entry.name.startswith(".new-")
    ]
    if not names:
        return None
    proc = subprocess.run(
        ["fzf", "--height", "40%", "--reverse", "--prompt", "workset> "],
        input="\n".join(names) + "\n",
        text=True,
        capture_output=True,
        check=False,
    )
    chosen = proc.stdout.strip()
    if proc.returncode != 0 or not chosen:
        return None
    return parent / chosen


def resolve_workset_dir(name: str | None, *, archived: bool = False, interactive: bool = False) -> Path:
    if name:
        ws_dir = get_workset_dir(name, archived=archived)
        if not ws_dir.is_dir():
            raise FileNotFoundError(f"Workset '{name}' not found.")
        return ws_dir
    ctx = get_workset_context()
    if ctx and ctx[1]:
        matches = find_matching_worksets(ctx[0], ctx[1], archived=archived)
        if len(matches) == 1:
            return matches[0]
        if interactive:
            picked = _select_workset_with_fzf(archived=archived)
            if picked is not None:
                return picked
        raise ValueError(
            f"Expected one workset for '{ctx[0]}' on '{ctx[1]}'; found {len(matches)}. Specify a name."
        )
    if interactive:
        picked = _select_workset_with_fzf(archived=archived)
        if picked is not None:
            return picked
    raise ValueError("Specify a workset name outside a repository or on detached HEAD.")


def _find_repo_dir_by_name(repo_name: str, metadata: dict) -> Path | None:
    for repo in metadata.get("repositories") or []:
        if isinstance(repo, dict):
            r_root = repo.get("root")
            if r_root and Path(r_root).name == repo_name and Path(r_root).is_dir():
                return Path(r_root)
    origin_root = metadata.get("originRoot")
    if origin_root and Path(origin_root).name == repo_name and Path(origin_root).is_dir():
        return Path(origin_root)
    roots_file = resolve_project_roots_file()
    for raw_root in read_config_lines(roots_file):
        base = Path(os.path.expandvars(raw_root)).expanduser()
        if not base.is_dir():
            continue
        direct = base / repo_name
        if (direct / ".git").exists():
            return direct
        try:
            for child in base.iterdir():
                cand = child / repo_name
                if child.is_dir() and (cand / ".git").exists():
                    return cand
        except OSError:
            continue
    return None


def _encode_workset_path(full_path: Path, repo_root: str | None) -> str:
    if repo_root:
        root_p = Path(repo_root).resolve()
        try:
            rel = full_path.resolve().relative_to(root_p)
            return f"{root_p.name}/{rel.as_posix()}"
        except ValueError:
            pass
    return str(full_path.resolve())


def _decode_workset_path(raw_line: str, metadata: dict) -> Path:
    p = Path(raw_line)
    if p.is_absolute():
        return p
    parts = raw_line.split("/", 1)
    if len(parts) == 2:
        repo_name, rel = parts
        repo_dir = _find_repo_dir_by_name(repo_name, metadata)
        if repo_dir is not None:
            return repo_dir / rel
    raise ValueError(f"Could not resolve relative workset path '{raw_line}'.")


def read_workset_files(ws_dir: Path, metadata: dict | None = None) -> list[Path]:
    list_file = ws_dir / "files.txt"
    if not list_file.is_file():
        raise FileNotFoundError(f"Workset file list is missing: {list_file}")
    if metadata is None:
        meta_path = ws_dir / "metadata.json"
        metadata = json.loads(meta_path.read_text(encoding="utf-8", errors="replace")) if meta_path.is_file() else {}
    files: list[Path] = []
    seen: set[str] = set()
    for raw in list_file.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        p = _decode_workset_path(line, metadata)
        if not p.is_file():
            raise FileNotFoundError(f"Workset file not found: {line}")
        resolved = p.resolve()
        key = str(resolved)
        if key not in seen:
            seen.add(key)
            files.append(resolved)
    return files


def discover_vs_solutions(root: Path, max_depth: int = 3) -> list[Path]:
    skip = {".git", "node_modules", "bin", "obj", ".vs", "packages"}
    found: list[Path] = []

    def _walk(cur: Path, depth: int) -> None:
        try:
            entries = sorted(cur.iterdir(), key=lambda p: p.name.lower())
        except OSError:
            return
        for entry in entries:
            if entry.is_file() and entry.suffix.lower() in (".sln", ".slnx"):
                found.append(entry)
            elif entry.is_dir() and not entry.is_symlink() and entry.name not in skip and depth < max_depth:
                _walk(entry, depth + 1)

    _walk(root, 0)
    return found


def resolve_vs_devenv() -> str | None:
    found = shutil.which("devenv.exe") or shutil.which("devenv")
    if found:
        return found
    vswhere = Path("/mnt/c/Program Files (x86)/Microsoft Visual Studio/Installer/vswhere.exe")
    if vswhere.is_file():
        res = subprocess.run(
            [str(vswhere), "-latest", "-products", "*", "-property", "productPath"],
            capture_output=True,
            text=True,
            check=False,
        )
        win_path = res.stdout.strip().splitlines()[0].strip() if res.returncode == 0 and res.stdout.strip() else ""
        if win_path:
            wsl_res = subprocess.run(["wslpath", "-u", win_path], capture_output=True, text=True, check=False)
            cand = wsl_res.stdout.strip()
            if wsl_res.returncode == 0 and cand and Path(cand).is_file():
                return cand
    return None


def to_windows_path(path: Path) -> str:
    if shutil.which("wslpath"):
        res = subprocess.run(["wslpath", "-w", str(path)], capture_output=True, text=True, check=False)
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()
    return str(path)


def _parse_workset_and_files(
    item: str | None,
    extra_paths: list[str],
    files_flag: list[str] | None,
    usage: str,
) -> tuple[str | None, list[str]]:
    raw_inputs: list[str] = []
    ws_name: str | None = None

    def _is_file_token(token: str) -> bool:
        if Path(token).is_file():
            return True
        cand_dir: Path | None = None
        try:
            cand_dir = get_workset_dir(token)
        except ValueError:
            cand_dir = None
        return ("/" in token or "\\" in token) and not (cand_dir and cand_dir.is_dir())

    if files_flag:
        raw_inputs.extend(files_flag)
        if item:
            if _is_file_token(item):
                raw_inputs.append(item)
            else:
                ws_name = item
        raw_inputs.extend(extra_paths)
    elif extra_paths:
        if item and _is_file_token(item):
            raw_inputs.append(item)
        else:
            ws_name = item
        raw_inputs.extend(extra_paths)
    elif item:
        raw_inputs.append(item)
    else:
        raise ValueError(usage)
    return ws_name, raw_inputs


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="workset",
        description="Manage named cross-repository issue file sets.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Actions:\n"
            "  list [--archived]                  List active or archived worksets (default)\n"
            "  new [<name>]                       Create workset (defaults to current branch)\n"
            "  add [<name>] <file>...             Add files to current or named workset\n"
            "  rm [<name>] <file>...              Remove files from current or named workset\n"
            "  show [<name>] [--archived]         Print files stored in workset\n"
            "  edit [<name>]                      Open files.txt in editor\n"
            "  open [<name>] [--code|--vs]        Open workset (splits VS/.NET & VS Code by default)\n"
            "  archive [<name>]                   Move active workset to archived\n"
            "  restore [<name>]                   Restore archived workset to active\n"
            "  delete [<name>] [--archived]       Remove a workset permanently\n"
        ),
    )
    parser.add_argument("tokens", nargs="*", help="Action and arguments")
    parser.add_argument("-f", "--files", nargs="+", dest="files_flag", help="Files to add/remove (on 'add'/'rm')")
    parser.add_argument("--code", action="store_true", help="Open all workset files in VS Code ('open' only)")
    parser.add_argument("--vs", action="store_true", help="Force Visual Studio ('open' only)")
    parser.add_argument("--archived", action="store_true", help="Target archived worksets (list/show/delete)")
    parser.add_argument("--what-if", action="store_true", help="Preview mutating or launch actions without executing")
    parser.add_argument("--current-name", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--prompt-badge", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--root", help=argparse.SUPPRESS)
    parser.add_argument("--branch", help=argparse.SUPPRESS)
    return parser


def main(argv: list[str] | None = None) -> int:
    raw = sys.argv[1:] if argv is None else argv
    args = build_parser().parse_args(normalize_legacy_flags(raw))

    if args.current_name:
        name = get_current_workset_name(args.root or "", args.branch or "")
        if name:
            print(name)
        return 0

    if args.prompt_badge:
        badge = get_current_workset_badge(args.root or "", args.branch or "")
        if badge:
            print(badge)
        return 0

    tokens = list(args.tokens)
    if not tokens:
        action = "list"
        rest: list[str] = []
    elif tokens[0].lower() in VALID_ACTIONS:
        action = tokens[0].lower()
        rest = tokens[1:]
    else:
        print(ctext(f"Unknown action '{tokens[0]}'. Expected one of: {', '.join(VALID_ACTIONS)}", "red"), file=sys.stderr)
        return 2

    if args.code and args.vs:
        print(ctext("Choose either --code or --vs.", "red"), file=sys.stderr)
        return 2
    if (args.code or args.vs) and action != "open":
        print(ctext("--code and --vs are only valid with 'open'.", "red"), file=sys.stderr)
        return 2
    if args.files_flag and action not in ("add", "rm"):
        print(ctext("--files is only valid with 'add' or 'rm'.", "red"), file=sys.stderr)
        return 2
    if args.archived and action not in ("list", "show", "delete"):
        print(ctext("--archived is only valid with 'list', 'show', or 'delete'.", "red"), file=sys.stderr)
        return 2

    item = rest[0] if rest else None
    extra_paths = rest[1:] if len(rest) > 1 else []

    if action not in ("add", "rm") and extra_paths:
        print(ctext(f"Unexpected arguments: {', '.join(extra_paths)}", "red"), file=sys.stderr)
        return 2

    try:
        if action == "list":
            sub = "archived" if args.archived else "active"
            parent = resolve_worksets_root() / sub
            if parent.is_dir():
                for entry in sorted(parent.iterdir(), key=lambda p: p.name.lower()):
                    if entry.is_dir() and not entry.name.startswith(".new-"):
                        print(entry.name)
            return 0

        if action == "new":
            ctx = get_workset_context()
            if not item:
                if not ctx or not ctx[1]:
                    raise ValueError("A workset name is required outside a repository or on detached HEAD.")
                item = ctx[1]
            name = convert_to_workset_name(item)
            ws_dir = get_workset_dir(name, archived=False)
            arch_dir = get_workset_dir(name, archived=True)
            if ws_dir.exists() or arch_dir.exists():
                raise ValueError(f"Workset '{name}' already exists, including archived worksets.")
            if args.what_if:
                print(ctext(f"WHAT-IF: Create workset '{name}' at {ws_dir}", "cyan"))
                return 0
            ws_dir.parent.mkdir(parents=True, exist_ok=True)
            staging = ws_dir.parent / f".new-{uuid.uuid4().hex}"
            try:
                staging.mkdir(parents=True, exist_ok=True)
                metadata = {
                    "name": name,
                    "originRoot": ctx[0] if ctx else None,
                    "branch": ctx[1] if ctx else None,
                    "repositories": [],
                }
                (staging / "metadata.json").write_text(json.dumps(metadata, indent=2), encoding="utf-8", newline="\n")
                (staging / "files.txt").write_text("", encoding="utf-8", newline="\n")
                os.replace(staging, ws_dir)
            finally:
                if staging.exists():
                    shutil.rmtree(staging, ignore_errors=True)
            print(ctext(f"✓ Created workset '{name}'.", "green"))
            return 0

        if action == "add":
            ws_name, raw_inputs = _parse_workset_and_files(
                item,
                extra_paths,
                args.files_flag,
                "Usage: workset add [<name>] <file>... | workset add [<name>] --files <file>...",
            )

            ws_dir = resolve_workset_dir(ws_name)
            list_path = ws_dir / "files.txt"
            meta_path = ws_dir / "metadata.json"
            metadata = json.loads(meta_path.read_text(encoding="utf-8", errors="replace"))
            existing = list_path.read_text(encoding="utf-8", errors="replace").splitlines()
            added: list[str] = []
            repositories: list[dict] = list(metadata.get("repositories") or [])
            known_roots = {r.get("root") for r in repositories if isinstance(r, dict)}

            for f_raw in raw_inputs:
                p = Path(f_raw).expanduser()
                if not p.is_file():
                    raise FileNotFoundError(f"File not found: {f_raw}")
                resolved_p = p.resolve()
                ctx = get_workset_context(resolved_p.parent)
                if ctx and ctx[1] and ctx[0] not in known_roots:
                    repositories.append({"root": ctx[0], "name": Path(ctx[0]).name, "branch": ctx[1]})
                    known_roots.add(ctx[0])
                entry_str = _encode_workset_path(resolved_p, ctx[0] if ctx else None)
                if entry_str not in existing and str(resolved_p) not in existing and entry_str not in added:
                    added.append(entry_str)

            if added:
                if args.what_if:
                    print(ctext(f"WHAT-IF: Add {len(added)} file(s) to '{metadata.get('name', ws_dir.name)}'", "cyan"))
                    return 0
                metadata["repositories"] = repositories
                meta_path.write_text(json.dumps(metadata, indent=2), encoding="utf-8", newline="\n")
                new_lines = [*existing, *added]
                list_path.write_text("\n".join(new_lines) + "\n", encoding="utf-8", newline="\n")
                print(ctext(f"✓ Added {len(added)} file(s) to '{metadata.get('name', ws_dir.name)}'.", "green"))
            return 0

        if action == "rm":
            ws_name, raw_inputs = _parse_workset_and_files(
                item,
                extra_paths,
                args.files_flag,
                "Usage: workset rm [<name>] <file>... | workset rm [<name>] --files <file>...",
            )
            ws_dir = resolve_workset_dir(ws_name)
            list_path = ws_dir / "files.txt"
            meta_path = ws_dir / "metadata.json"
            metadata = json.loads(meta_path.read_text(encoding="utf-8", errors="replace")) if meta_path.is_file() else {}
            existing = list_path.read_text(encoding="utf-8", errors="replace").splitlines()

            targets: set[str] = set()
            for f_raw in raw_inputs:
                targets.add(f_raw.strip())
                p = Path(f_raw).expanduser()
                if p.exists():
                    rp = p.resolve()
                    targets.add(str(rp))
                    ctx = get_workset_context(rp.parent)
                    if ctx:
                        targets.add(_encode_workset_path(rp, ctx[0]))

            kept: list[str] = []
            removed = 0
            for line in existing:
                s = line.strip()
                if not s or s.startswith("#"):
                    kept.append(line)
                    continue
                matched = s in targets
                if not matched:
                    try:
                        decoded = str(_decode_workset_path(s, metadata).resolve())
                        matched = decoded in targets
                    except (ValueError, OSError):
                        matched = False
                if matched:
                    removed += 1
                else:
                    kept.append(line)

            if args.what_if:
                print(ctext(f"WHAT-IF: Remove {removed} file(s) from '{metadata.get('name', ws_dir.name)}'", "cyan"))
                return 0
            if removed:
                list_path.write_text(("\n".join(kept) + "\n") if kept else "", encoding="utf-8", newline="\n")
                print(ctext(f"✓ Removed {removed} file(s) from '{metadata.get('name', ws_dir.name)}'.", "green"))
            else:
                print(ctext("No matching files found in workset.", "yellow"))
            return 0

        if action == "show":
            ws_dir = resolve_workset_dir(item, archived=args.archived, interactive=True)
            print(f"\n{ctext('Workset:', 'cyan')} {ctext(ws_dir.name, 'white')}")
            content = (ws_dir / "files.txt").read_text(encoding="utf-8", errors="replace")
            if content:
                print(content.rstrip())
            return 0

        if action == "edit":
            ws_dir = resolve_workset_dir(item)
            list_file = ws_dir / "files.txt"
            editor_cmd = os.environ.get("VISUAL") or os.environ.get("EDITOR")
            if args.what_if:
                print(ctext(f"WHAT-IF: Edit {list_file}", "cyan"))
                return 0
            if shutil.which("code"):
                proc = subprocess.run(["code", "--wait", str(list_file)])
                return proc.returncode
            if editor_cmd:
                proc = subprocess.run([*editor_cmd.split(), str(list_file)])
                return proc.returncode
            raise FileNotFoundError("No editor found (install VS Code 'code' or set VISUAL/EDITOR).")

        if action == "open":
            ws_dir = resolve_workset_dir(item, interactive=True)
            metadata = json.loads((ws_dir / "metadata.json").read_text(encoding="utf-8", errors="replace"))
            files = read_workset_files(ws_dir, metadata=metadata)
            if not files:
                raise ValueError("The workset has no files.")

            roots: list[str] = []
            grouped: dict[str, list[Path]] = {}
            all_in_repos = True
            for fp in files:
                ctx = get_workset_context(fp.parent)
                if ctx:
                    r_str = ctx[0]
                else:
                    all_in_repos = False
                    r_str = str(fp.parent)
                if r_str not in roots:
                    roots.append(r_str)
                grouped.setdefault(r_str, []).append(fp)

            for repo in metadata.get("repositories") or []:
                r_root = repo.get("root")
                if not r_root or r_root not in roots:
                    continue
                if not Path(r_root).is_dir():
                    print(ctext(f"WARNING: Recorded repository is missing: {r_root}", "yellow"), file=sys.stderr)
                    continue
                cur = get_workset_context(Path(r_root))
                cur_branch = cur[1] if cur else None
                if not cur or cur_branch != repo.get("branch"):
                    print(
                        ctext(
                            f"WARNING: Branch mismatch in '{r_root}': expected '{repo.get('branch')}', current '{cur_branch}'.",
                            "yellow",
                        ),
                        file=sys.stderr,
                    )

            single_repo = all_in_repos and len(roots) == 1
            if args.vs and not single_repo:
                raise ValueError("Visual Studio requires all workset files to belong to one repository; omit --vs or use --code.")

            if args.code:
                if args.what_if:
                    print(ctext(f"WHAT-IF: Open workset '{ws_dir.name}' in VS Code ({len(files)} file(s))", "cyan"))
                    return 0
                code_bin = shutil.which("code")
                if not code_bin:
                    raise FileNotFoundError("✖ workset: VS Code command ('code') not found in PATH.")
                proc = subprocess.run([code_bin, "--new-window", *roots, *(str(f) for f in files)])
                return proc.returncode

            if args.vs:
                solutions = discover_vs_solutions(Path(roots[0]))
                if not solutions:
                    raise ValueError(f"No Visual Studio solution found for '{roots[0]}'.")
                if args.what_if:
                    print(ctext(f"WHAT-IF: Open workset '{ws_dir.name}' in Visual Studio ({solutions[0]})", "cyan"))
                    return 0
                devenv = resolve_vs_devenv()
                if not devenv:
                    raise FileNotFoundError("Visual Studio launcher ('devenv') not found in PATH or via vswhere.exe; pass --code.")
                win_targets = [to_windows_path(solutions[0]), *(to_windows_path(f) for f in files)]
                subprocess.Popen(
                    [devenv, *win_targets],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
                return 0

            # Default: hybrid split mode (Visual Studio for .sln/.slnx repos, VS Code for the rest)
            vs_launches: list[tuple[str, Path, list[Path]]] = []
            code_roots: list[str] = []
            code_files: list[Path] = []
            for r_str in roots:
                r_files = grouped[r_str]
                sols = discover_vs_solutions(Path(r_str)) if (Path(r_str) / ".git").exists() else []
                if sols:
                    vs_launches.append((r_str, sols[0], r_files))
                else:
                    code_roots.append(r_str)
                    code_files.extend(r_files)

            devenv = resolve_vs_devenv() if vs_launches else None
            if vs_launches and not devenv:
                for r_str, _sol, r_files in vs_launches:
                    code_roots.append(r_str)
                    code_files.extend(r_files)
                vs_launches.clear()

            if args.what_if:
                for _r_str, sol, r_files in vs_launches:
                    print(ctext(f"WHAT-IF: Open workset '{ws_dir.name}' in Visual Studio ({sol}, {len(r_files)} file(s))", "cyan"))
                if code_files:
                    print(ctext(f"WHAT-IF: Open workset '{ws_dir.name}' in VS Code ({len(code_files)} file(s))", "cyan"))
                return 0

            for _r_str, sol, r_files in vs_launches:
                assert devenv is not None
                win_targets = [to_windows_path(sol), *(to_windows_path(f) for f in r_files)]
                subprocess.Popen(
                    [devenv, *win_targets],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            if code_files:
                code_bin = shutil.which("code")
                if not code_bin:
                    raise FileNotFoundError("✖ workset: VS Code command ('code') not found in PATH.")
                proc = subprocess.run([code_bin, "--new-window", *code_roots, *(str(f) for f in code_files)])
                return proc.returncode
            return 0

        if action == "archive":
            ws_dir = resolve_workset_dir(item, archived=False)
            dest = get_workset_dir(ws_dir.name, archived=True)
            if dest.exists():
                raise ValueError(f"Archive already exists: {dest}")
            if args.what_if:
                print(ctext(f"WHAT-IF: Archive workset '{ws_dir.name}' -> {dest}", "cyan"))
                return 0
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(ws_dir), str(dest))
            print(ctext(f"✓ Archived workset '{ws_dir.name}'.", "green"))
            return 0

        if action == "restore":
            ws_dir = resolve_workset_dir(item, archived=True)
            dest = get_workset_dir(ws_dir.name, archived=False)
            if dest.exists():
                raise ValueError(f"Active workset already exists: {dest}")
            if args.what_if:
                print(ctext(f"WHAT-IF: Restore workset '{ws_dir.name}' -> {dest}", "cyan"))
                return 0
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(ws_dir), str(dest))
            print(ctext(f"✓ Restored workset '{ws_dir.name}'.", "green"))
            return 0

        if action == "delete":
            ws_dir = resolve_workset_dir(item, archived=args.archived)
            if args.what_if:
                print(ctext(f"WHAT-IF: Delete workset '{ws_dir.name}'", "cyan"))
                return 0
            shutil.rmtree(ws_dir)
            print(ctext(f"✓ Deleted workset '{ws_dir.name}'.", "green"))
            return 0

    except (ValueError, FileNotFoundError) as exc:
        print(ctext(str(exc), "red"), file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
