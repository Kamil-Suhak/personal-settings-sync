{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0",
  "packages": [
    {
      "id": "Microsoft.VisualStudioCode",
      "name": "Visual Studio Code",
      "category": "Development"
    },
    {
      "id": "Brave.Brave",
      "name": "Brave Browser",
      "category": "Browsers"
    },
    {
      "id": "Spotify.Spotify",
      "name": "Spotify",
      "category": "Media"
    },
    {
      "id": "Git.Git",
      "name": "Git",
      "category": "Development"
    },
    {
      "id": "GitHub.cli",
      "name": "GitHub CLI",
      "category": "Development"
    },
    {
      "id": "OpenJS.NodeJS.LTS",
      "name": "Node.js (LTS)",
      "category": "Development"
    },
    {
      "id": "Python.Latest",
      "name": "Python 3 (Latest)",
      "category": "Development"
    }
  ],
  "fonts": [
    {
      "name": "JetBrains Mono",
      "repo": "JetBrains/JetBrainsMono",
      "fallbackUrl": "https://download.jetbrains.com/fonts/JetBrainsMono-2.304.zip",
      "checkFile": "JetBrainsMono-Regular.ttf"
    }
  ],
  "apps": [
    {
      "name": "vscode",
      "displayName": "Visual Studio Code",
      "description": "Editor configuration and keybindings",
      "files": [
        {
          "repoPath": "configs/vscode/settings.json",
          "localPath": "%APPDATA%/Code/User/settings.json",
          "required": true
        },
        {
          "repoPath": "configs/vscode/keybindings.json",
          "localPath": "%APPDATA%/Code/User/keybindings.json",
          "required": false
        }
      ]
    },
    {
      "name": "powershell",
      "displayName": "PowerShell Profile",
      "description": "PowerShell 7+ and Windows PowerShell 5.1 profile",
      "files": [
        {
          "repoPath": "configs/powershell/Microsoft.PowerShell_profile.ps1",
          "localPath": "$DOCUMENTS/PowerShell/Microsoft.PowerShell_profile.ps1",
          "required": true
        },
        {
          "repoPath": "configs/powershell/Microsoft.PowerShell_profile.ps1",
          "localPath": "$DOCUMENTS/WindowsPowerShell/Microsoft.PowerShell_profile.ps1",
          "required": true
        }
      ]
    },
    {
      "name": "terminal",
      "displayName": "Windows Terminal",
      "description": "Windows Terminal profiles, keybindings, and color schemes",
      "files": [
        {
          "repoPath": "configs/terminal/settings.json",
          "localPath": "%LOCALAPPDATA%/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState/settings.json",
          "required": true
        }
      ]
    },
    {
      "name": "git",
      "displayName": "Git",
      "description": "Global Git configuration",
      "files": [
        {
          "repoPath": "configs/git/.gitconfig",
          "localPath": "%USERPROFILE%/.gitconfig",
          "required": true
        }
      ]
    },
    {
      "name": "gemini",
      "displayName": "AI Agent Rules",
      "description": "Global AGENTS.md and GEMINI.md rules for AI coding assistants",
      "files": [
        {
          "repoPath": "configs/gemini/AGENTS.md",
          "localPath": "%USERPROFILE%/.gemini/AGENTS.md",
          "required": true
        },
        {
          "repoPath": "configs/gemini/GEMINI.md",
          "localPath": "%USERPROFILE%/.gemini/GEMINI.md",
          "required": true
        },
        {
          "repoPath": "configs/gemini/skills.json",
          "localPath": "%USERPROFILE%/.gemini/config/skills.json",
          "required": true
        }
      ]
    }
  ],
  "skills": [
    "developer-profile",
    "repo-intro"
  ]
}
