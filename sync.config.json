{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "4.0",
  "workspacesDir": "workspaces",
  "defaultWorkspace": "personal",
  "packages": [
    {
      "id": "VisualStudioCode",
      "arch": "visual-studio-code-bin",
      "apt": "code",
      "name": "Visual Studio Code",
      "category": "Development"
    },
    {
      "id": "Git",
      "arch": "git",
      "apt": "git",
      "name": "Git",
      "category": "Development"
    },
    {
      "id": "GitHubCLI",
      "arch": "github-cli",
      "apt": "gh",
      "name": "GitHub CLI",
      "category": "Development"
    },
    {
      "id": "NodeJS",
      "arch": "nodejs",
      "apt": "nodejs",
      "name": "Node.js",
      "category": "Development"
    },
    {
      "id": "Python3",
      "arch": "python",
      "apt": "python3",
      "name": "Python 3",
      "category": "Development"
    },
    {
      "id": "DotnetSdk10",
      "arch": "dotnet-sdk",
      "apt": "dotnet-sdk-10.0",
      "name": ".NET SDK 10.0",
      "category": "Development",
      "workspaces": ["work"]
    },
    {
      "id": "Zsh",
      "arch": "zsh",
      "apt": "zsh",
      "name": "Zsh",
      "category": "Shell"
    },
    {
      "id": "ZshAutosuggestions",
      "arch": "zsh-autosuggestions",
      "apt": "zsh-autosuggestions",
      "name": "Zsh Autosuggestions",
      "category": "Shell"
    },
    {
      "id": "ZshSyntaxHighlighting",
      "arch": "zsh-syntax-highlighting",
      "apt": "zsh-syntax-highlighting",
      "name": "Zsh Syntax Highlighting",
      "category": "Shell"
    },
    {
      "id": "Fzf",
      "arch": "fzf",
      "apt": "fzf",
      "name": "fzf Fuzzy Finder",
      "category": "Shell"
    },
    {
      "id": "Starship",
      "arch": "starship",
      "apt": "starship",
      "name": "Starship Prompt",
      "category": "Shell"
    },
    {
      "id": "Fd",
      "arch": "fd",
      "apt": "fd-find",
      "name": "fd File Finder",
      "category": "Search"
    },
    {
      "id": "Ripgrep",
      "arch": "ripgrep",
      "apt": "ripgrep",
      "name": "ripgrep",
      "category": "Search"
    },
    {
      "id": "Jq",
      "arch": "jq",
      "apt": "jq",
      "name": "jq JSON Processor",
      "category": "CLI"
    },
    {
      "id": "GitDelta",
      "arch": "git-delta",
      "apt": "git-delta",
      "name": "git-delta",
      "category": "Development"
    },
    {
      "id": "BraveBrowser",
      "arch": "brave-bin",
      "name": "Brave Browser",
      "category": "Browsers",
      "workspaces": ["personal"]
    },
    {
      "id": "Spotify",
      "arch": "spotify",
      "name": "Spotify",
      "category": "Media",
      "workspaces": ["personal"]
    },
    {
      "id": "WlClipboard",
      "arch": "wl-clipboard",
      "apt": "wl-clipboard",
      "name": "Wayland Clipboard (wl-copy / wl-paste)",
      "category": "Utilities",
      "workspaces": ["personal"]
    },
    {
      "id": "D2",
      "arch": "d2",
      "name": "D2 Diagramming CLI",
      "category": "Development",
      "workspaces": ["personal"]
    }
  ],
  "fonts": [
    {
      "name": "JetBrains Mono",
      "archPackage": "ttf-jetbrains-mono-nerd",
      "repo": "JetBrains/JetBrainsMono",
      "fallbackUrl": "https://download.jetbrains.com/fonts/JetBrainsMono-2.304.zip",
      "checkFile": "JetBrainsMono-Regular.ttf"
    }
  ],
  "subsystems": {
    "zsh": {
      "displayName": "Zsh Profile",
      "sharedPath": "configs/zsh/init.zsh",
      "workspacePath": "workspaces/{workspace}/zsh/profile.zsh",
      "localTarget": "~/.zshrc"
    },
    "starship": {
      "displayName": "Starship Prompt",
      "sharedPath": "configs/starship/starship.toml",
      "localTarget": "~/.config/starship.toml"
    },
    "git": {
      "displayName": "Git Config",
      "sharedPath": "configs/git/.gitconfig.shared",
      "workspacePath": "workspaces/{workspace}/git/.gitconfig",
      "localTarget": "~/.gitconfig",
      "hooksDir": "configs/git/hooks",
      "hooksTarget": "~/.git-hooks"
    },
    "gemini": {
      "displayName": "AI Agent Rules",
      "files": [
        {
          "name": "AGENTS.md",
          "repoPath": "configs/gemini/AGENTS.md",
          "workspacePath": "workspaces/{workspace}/gemini/AGENTS.md",
          "localPath": "~/.gemini/AGENTS.md",
          "mode": "concat"
        },
        {
          "name": "GEMINI.md",
          "repoPath": "configs/gemini/GEMINI.md",
          "workspacePath": "workspaces/{workspace}/gemini/GEMINI.md",
          "localPath": "~/.gemini/GEMINI.md",
          "mode": "concat"
        },
        {
          "name": "skills.json",
          "repoPath": "configs/gemini/skills.json",
          "localPath": "~/.gemini/config/skills.json",
          "mode": "template"
        }
      ]
    },
    "skills": {
      "displayName": "AI Skills",
      "repoDir": "configs/skills",
      "workspaceDir": "workspaces/{workspace}/skills",
      "targetDir": "~/.agents/skills",
      "mirrorLinks": [
        "~/.gemini/skills"
      ],
      "items": [
        "developer-profile",
        "repo-intro",
        "ask",
        "ux",
        "readme",
        "visualize"
      ]
    },
    "plugins": {
      "displayName": "AI Plugins",
      "repoDir": "configs/plugins",
      "targetDir": "~/.gemini/config/plugins",
      "items": [
        "egm"
      ]
    }
  }
}
