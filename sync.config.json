{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "3.0",
  "workspacesDir": "workspaces",
  "defaultWorkspace": "personal",
  "packages": [
    {
      "id": "Microsoft.VisualStudioCode",
      "name": "Visual Studio Code",
      "category": "Development"
    },
    {
      "id": "Git.Git",
      "name": "Git",
      "category": "Development"
    },
    {
      "id": "GitHub.cli",
      "name": "GitHub CLI",
      "category": "Development"
    },
    {
      "id": "OpenJS.NodeJS.LTS",
      "name": "Node.js (LTS)",
      "category": "Development"
    },
    {
      "id": "Python.Latest",
      "name": "Python 3 (Latest)",
      "category": "Development"
    },
    {
      "id": "Brave.Brave",
      "name": "Brave Browser",
      "category": "Browsers",
      "workspaces": ["personal"]
    },
    {
      "id": "Spotify.Spotify",
      "name": "Spotify",
      "category": "Media",
      "workspaces": ["personal"]
    }
  ],
  "fonts": [
    {
      "name": "JetBrains Mono",
      "repo": "JetBrains/JetBrainsMono",
      "fallbackUrl": "https://download.jetbrains.com/fonts/JetBrainsMono-2.304.zip",
      "checkFile": "JetBrainsMono-Regular.ttf"
    }
  ],
  "subsystems": {
    "powershell": {
      "displayName": "PowerShell Profile",
      "sharedPath": "configs/powershell/Microsoft.PowerShell_profile.ps1",
      "workspacePath": "workspaces/{workspace}/powershell/profile.ps1",
      "localTarget": "$DOCUMENTS/PowerShell/Microsoft.PowerShell_profile.ps1"
    },
    "git": {
      "displayName": "Git Config",
      "sharedPath": "configs/git/.gitconfig.shared",
      "workspacePath": "workspaces/{workspace}/git/.gitconfig",
      "localTarget": "%USERPROFILE%/.gitconfig"
    },
    "gemini": {
      "displayName": "AI Agent Rules",
      "files": [
        {
          "name": "AGENTS.md",
          "repoPath": "configs/gemini/AGENTS.md",
          "workspacePath": "workspaces/{workspace}/gemini/AGENTS.md",
          "localPath": "%USERPROFILE%/.gemini/AGENTS.md",
          "mode": "concat"
        },
        {
          "name": "GEMINI.md",
          "repoPath": "configs/gemini/GEMINI.md",
          "workspacePath": "workspaces/{workspace}/gemini/GEMINI.md",
          "localPath": "%USERPROFILE%/.gemini/GEMINI.md",
          "mode": "concat"
        },
        {
          "name": "skills.json",
          "repoPath": "configs/gemini/skills.json",
          "localPath": "%USERPROFILE%/.gemini/config/skills.json",
          "mode": "template"
        }
      ]
    },
    "skills": {
      "displayName": "AI Skills",
      "repoDir": "configs/skills",
      "workspaceDir": "workspaces/{workspace}/skills",
      "targetDir": "%USERPROFILE%/.agents/skills",
      "mirrorLinks": [
        "%USERPROFILE%/.gemini/skills"
      ],
      "items": [
        "developer-profile",
        "repo-intro",
        "ask",
        "ux",
        "readme"
      ]
    },
    "plugins": {
      "displayName": "AI Plugins",
      "repoDir": "configs/plugins",
      "targetDir": "%USERPROFILE%/.gemini/config/plugins",
      "items": [
        "egm"
      ]
    }
  }
}
