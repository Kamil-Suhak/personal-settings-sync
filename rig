            else:
                existing = lp.read_text(encoding="utf-8", errors="replace") if lp.is_file() else ""
                updated = self.build_updated_gitconfig(existing, gs["desired"])
                if self.args.what_if:
                    badge("WHAT-IF", "cyan", f"Would update [include] blocks in {lp}")
                else:
                    if existing and not self.args.no_backup:
                        bdest = self.backup_dir / "git" / ".gitconfig"
                        bdest.parent.mkdir(parents=True, exist_ok=True)
                        shutil.copy2(lp, bdest)
                        badge("BACKUP", "darkcyan", f"Backed up -> {bdest.relative_to(SCRIPT_DIR)}")
                    write_utf8_file(lp, updated)
                    badge("APPLIED", "green", f"Updated [include] layers (shared + {workspace}) -> {lp}")
                    applied += 1

            hl = self.get_git_hooks_link()
            if hl and self.sync_link(hl["source"], hl["target"], "git/.git-hooks"):
                applied += 1

        if self.should_process("gemini"):
            print(ctext("\n[AI Agent Rules]", "yellow"))
            for f in self.config["subsystems"]["gemini"]["files"]:
                lp = self.resolve_dynamic_path(f["localPath"])
                exp = self.expected_gemini_content(f, workspace)
                if exp is None:
                    continue
                if not self.args.force and file_hash_safe(lp) == text_hash(exp):
                    badge("OK", "darkgray", f"Already in sync: {lp}")
                    continue
                if self.args.what_if:
                    badge("WHAT-IF", "cyan", f"Would build {f['name']} -> {lp}")
                    continue
                if lp.is_file() and not self.args.no_backup:
                    bdest = self.backup_dir / "gemini" / f["name"]
                    bdest.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(lp, bdest)
                    badge("BACKUP", "darkcyan", f"Backed up -> {bdest.relative_to(SCRIPT_DIR)}")
                write_utf8_file(lp, exp)
                badge("APPLIED", "green", f"Built {f['name']} ({workspace}) -> {lp}")
                applied += 1

        if self.should_process("skills"):
            print(ctext("\n[AI Skills]", "yellow"))
            skills_dir = self.resolve_dynamic_path(self.config["subsystems"]["skills"]["targetDir"])
            if not self.args.what_if:
                skills_dir.mkdir(parents=True, exist_ok=True)
            desired_links = self.get_desired_skill_links(workspace)
            desired_targets = {os.path.normcase(os.path.abspath(str(l["target"]))) for l in desired_links}

            ws_root_prefix = os.path.normcase(os.path.abspath(str(SCRIPT_DIR / self.config["workspacesDir"]))).rstrip("/\\") + os.sep
            if skills_dir.is_dir():
                for entry in skills_dir.iterdir():
                    if not is_link(entry):
                        continue
                    lt = get_link_target(entry)
                    if lt and os.path.normcase(lt).startswith(ws_root_prefix) and os.path.normcase(os.path.abspath(str(entry))) not in desired_targets:
                        if self.args.what_if:
                            badge("WHAT-IF", "cyan", f"Would unlink stale workspace skill: {entry}")
                        else:
                            remove_existing_target(entry, None, "", True)
                            badge("UNLINKED", "darkyellow", f"Removed stale workspace skill link: {entry}")
                            applied += 1

            for link in desired_links:
                if self.sync_link(link["source"], link["target"], f"skills/{link['name']}"):
                    applied += 1

        if self.should_process("plugins"):
            print(ctext("\n[AI Plugins]", "yellow"))
            for link in self.get_desired_plugin_links():
                if self.sync_link(link["source"], link["target"], f"plugins/{link['name']}"):
                    applied += 1

        if not self.args.what_if:
            print(ctext(f"\nDone. Updated {applied} item(s).", "green"))
