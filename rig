                prune_backups()

    def cmd_diff(self, workspace: str) -> None:
        print(ctext(f"\n=== Comparing Local Machine vs Repo ({workspace}) ===", "cyan"))
        diffs = 0
        if self.should_process("zsh"):
            st = self.get_zsh_status()
            if st["status"] != "In Sync":
                diffs += 1
                print(ctext(f"\n--- Zsh Profile ({st['status']}) ---", "magenta"))
                if st["status"] == "Unmanaged Local File":
                    shared_zsh = SCRIPT_DIR / self.config["subsystems"]["zsh"]["sharedPath"]
                    subprocess.run(["git", "diff", "--no-index", "--color", str(shared_zsh), str(st["local_path"])])
                else:
                    print(f"Local: {st['local_path']}")
                    print(f"Expected loader:\n{st['expected']}")

        if self.should_process("starship"):
            sl = self.get_starship_link()
            ss = get_link_status(sl["source"], sl["target"])
            if ss != "Linked":
                diffs += 1
                print(ctext(f"\n--- Starship Prompt ({ss}) ---", "magenta"))
                print(f"Expected link: {sl['target']} -> {sl['source']}")

        if self.should_process("git"):
            gs = self.get_git_config_status(workspace)
            if gs["status"] != "In Sync":
                diffs += 1
                print(ctext(f"\n--- Git Config ({gs['status']}) ---", "magenta"))
                print(f"Expected includes in {gs['local_path']}:")
                for d in gs["desired"]:
                    print(ctext(f"  + {d}", "green"))
            hl = self.get_git_hooks_link()
            if hl:
                hs = get_link_status(hl["source"], hl["target"])
                if hs != "Linked":
                    diffs += 1
                    print(ctext(f"\n--- Git Hooks ({hs}) ---", "magenta"))
                    print(f"Expected link: {hl['target']} -> {hl['source']}")

        if self.should_process("gemini"):
            for f in self.config["subsystems"]["gemini"]["files"]:
                lp = self.resolve_dynamic_path(f["localPath"])
                exp = self.expected_gemini_content(f, workspace)
                if exp is None:
                    continue
                if not lp.is_file():
                    diffs += 1
                    print(ctext(f"\n--- AI Rules: {f['name']} (Missing on Machine) ---", "magenta"))
                    continue
                if file_hash_safe(lp) != text_hash(exp):
                    diffs += 1
                    print(ctext(f"\n--- AI Rules: {f['name']} ---", "magenta"))
                    import tempfile

                    with tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".txt", delete=False) as tf:
                        tf.write(normalize_lf(exp) + "\n")
                        tmp_path = tf.name
                    try:
                        subprocess.run(["git", "diff", "--no-index", "--color", tmp_path, str(lp)])
                    finally:
                        Path(tmp_path).unlink(missing_ok=True)

        if diffs == 0:
            badge("OK", "green", f"All inspected configurations are in sync with '{workspace}'.")

    def cmd_edit(self, workspace: str, sub: str | None, target_arg: str | None) -> None:
        known = {"zsh", "shell", "profile", "powershell", "ps", "starship", "git", "agents", "gemini", "skills.json"}
        if sub and not target_arg and sub.lower() in known:
            layer, target = "shared", sub.lower()
        else:
            layer = sub.lower() if sub else "shared"
            target = target_arg.lower() if target_arg else ""

        if not target:
            badge("ERROR", "red", "Usage: rig edit [<shared|workspace>] <zsh|starship|git|agents|gemini|skills.json>")
            raise SystemExit(1)

        if layer == "shared":
            mapping = {
                "zsh": self.config["subsystems"]["zsh"]["sharedPath"],
                "shell": self.config["subsystems"]["zsh"]["sharedPath"],
                "profile": self.config["subsystems"]["zsh"]["sharedPath"],
                "powershell": self.config["subsystems"]["zsh"]["sharedPath"],
                "ps": self.config["subsystems"]["zsh"]["sharedPath"],
                "starship": self.config["subsystems"]["starship"]["sharedPath"],
                "git": self.config["subsystems"]["git"]["sharedPath"],
                "agents": "configs/gemini/AGENTS.md",
                "gemini": "configs/gemini/GEMINI.md",
                "skills.json": "configs/gemini/skills.json",
            }
            rel = mapping.get(target)
        else:
            ws_name = workspace if layer == "workspace" else layer
            ws_root = SCRIPT_DIR / self.config["workspacesDir"] / ws_name
            if not ws_root.is_dir():
                badge("ERROR", "red", f"Workspace '{ws_name}' does not exist. Create it with 'rig workspace new {ws_name}'.")
                raise SystemExit(1)
            mapping = {
                "zsh": self.config["subsystems"]["zsh"]["workspacePath"].replace("{workspace}", ws_name),
                "shell": self.config["subsystems"]["zsh"]["workspacePath"].replace("{workspace}", ws_name),
                "profile": self.config["subsystems"]["zsh"]["workspacePath"].replace("{workspace}", ws_name),
                "powershell": self.config["subsystems"]["zsh"]["workspacePath"].replace("{workspace}", ws_name),
                "ps": self.config["subsystems"]["zsh"]["workspacePath"].replace("{workspace}", ws_name),
                "git": self.config["subsystems"]["git"]["workspacePath"].replace("{workspace}", ws_name),
                "agents": f"workspaces/{ws_name}/gemini/AGENTS.md",
                "gemini": f"workspaces/{ws_name}/gemini/GEMINI.md",
            }
            rel = mapping.get(target)

        if not rel:
            badge("ERROR", "red", f"Unknown edit target '{target}' for layer '{layer}'.")
            raise SystemExit(1)

        full_path = SCRIPT_DIR / rel
        if self.args.path_only:
            print(full_path)
            return

        if not full_path.is_file():
            write_utf8_file(full_path, "")
            badge("CREATED", "green", f"Created {rel}")

        editor = os.environ.get("EDITOR") or shutil.which("code") or shutil.which("xdg-open")
        if editor:
            import shlex
            cmd = shlex.split(editor) + [str(full_path)]
            subprocess.run(cmd)
        else:
            print(full_path)

    def _update_bootstrap_function(self, path: Path, name: str, code: str) -> None:
        if not path.is_file():
            raise RuntimeError(f"Cannot update function '{name}': '{path}' missing.")
        funcs = profile_groups.extract_shell_functions(path)
        if name not in funcs:
            raise RuntimeError(f"Cannot update function '{name}': '{path}' no longer contains it.")
        content = normalize_lf(path.read_text(encoding="utf-8", errors="replace"))
        old_block = normalize_lf(funcs[name])
        write_utf8_file(path, content.replace(old_block, normalize_lf(code), 1))

    def cmd_bootstrap(self, workspace: str) -> None:
        interactive = sys.stdin.isatty()
        print(ctext(f"\n=== RIG Machine Bootstrapper (Workspace: {workspace}) ===", "cyan"))

        if self.should_process("zsh"):
            local_zsh = self.resolve_dynamic_path(self.config["subsystems"]["zsh"]["localTarget"])
            shared_zsh = SCRIPT_DIR / self.config["subsystems"]["zsh"]["sharedPath"]
            ws_zsh = SCRIPT_DIR / self.config["subsystems"]["zsh"]["workspacePath"].replace("{workspace}", workspace)

            if not local_zsh.is_file():
                badge("INFO", "darkgray", f"No local zsh profile found at {local_zsh}.")
            elif self.is_managed_zsh_loader(local_zsh):
                badge("OK", "green", "Zsh profile is already managed by rig loader.")
            else:
                local_funcs = profile_groups.extract_shell_functions(local_zsh)
                shared_funcs: dict[str, tuple[str, Path]] = {}
                ws_funcs: dict[str, tuple[str, Path]] = {}
                for grp in profile_groups.get_profile_groups(SCRIPT_DIR, workspace):
                    fn_map = profile_groups.extract_shell_functions(grp["path"])
                    dest = shared_funcs if grp["scope"] == "shared" else ws_funcs
                    for fn, code in fn_map.items():
                        dest[fn] = (code, Path(grp["path"]))

                pending: list[tuple[str, str, str]] = []
                for name, code in local_funcs.items():
                    lh = text_hash(code)
                    sh = text_hash(shared_funcs[name][0]) if name in shared_funcs else None
                    wh = text_hash(ws_funcs[name][0]) if name in ws_funcs else None
                    if lh == sh or lh == wh:
                        continue
                    kind = "Modified" if (name in shared_funcs or name in ws_funcs) else "New"
                    pending.append((name, kind, code))

                if not pending:
                    badge("OK", "green", "All functions in local zsh profile already match repo.")
                else:
                    print(ctext(f"\nFound {len(pending)} new/modified shell function(s) in {local_zsh}:", "yellow"))
                    for name, kind, code in pending:
                        print(ctext(f"  - [{kind}] function {name}", "cyan"))
                        if self.args.what_if:
                            continue
                        if not interactive:
                            badge("ERROR", "red", f"Interactive session required to route '{name}'.")
                            raise SystemExit(1)
                        choice = input(
                            f"    Route 'function {name}' to: [S]hared, [W]orkspace ({workspace}), [L]ocal ({self.local_paths['local_profile']}), [I]gnore, [Q]uit: "
                        ).strip().upper()
                        if choice == "Q":
                            badge("ABORTED", "darkgray", "Bootstrap aborted.")
                            return
                        if choice == "S":
                            if name in shared_funcs:
                                target_path = shared_funcs[name][1]
                                self._update_bootstrap_function(target_path, name, code)
                            else:
                                target_path = shared_zsh
                                append_utf8_file(target_path, code)
                            badge("ROUTED", "green", f"Saved '{name}' -> {target_path}")
                        elif choice == "W":
                            if name in ws_funcs:
                                target_path = ws_funcs[name][1]
                                self._update_bootstrap_function(target_path, name, code)
                            else:
                                target_path = ws_zsh
                                append_utf8_file(target_path, code)
                            badge("ROUTED", "green", f"Saved '{name}' -> {target_path}")
                        elif choice == "L":
                            append_utf8_file(self.local_paths["local_profile"], code)
                            badge("ROUTED", "green", f"Added '{name}' -> {self.local_paths['local_profile']}")
                        else:
                            badge("SKIP", "darkgray", f"Ignored function '{name}'.")

        if self.should_process("git"):
            local_git = self.resolve_dynamic_path(self.config["subsystems"]["git"]["localTarget"])
            shared_git = SCRIPT_DIR / self.config["subsystems"]["git"]["sharedPath"]
            ws_git = SCRIPT_DIR / self.config["subsystems"]["git"]["workspacePath"].replace("{workspace}", workspace)

            if local_git.is_file():
                def git_sections(text: str) -> list[tuple[str, str]]:
                    secs: list[tuple[str, str]] = []
                    cur_h = None
                    cur_l: list[str] = []
                    for line in normalize_lf(text).split("\n"):
                        m = re.match(r"^\s*\[([^\]]+)\]\s*(?:[#;].*)?$", line)
                        if m:
                            if cur_h:
                                secs.append((cur_h, "\n".join(cur_l).rstrip()))
                            cur_h = m.group(1).strip()
                            cur_l = [line]
                        elif cur_h:
                            cur_l.append(line)
                    if cur_h:
                        secs.append((cur_h, "\n".join(cur_l).rstrip()))
                    return secs

                shared_hashes = {text_hash(t) for _, t in git_sections(shared_git.read_text(encoding="utf-8", errors="replace")) if shared_git.is_file()} if shared_git.is_file() else set()
                ws_hashes = {text_hash(t) for _, t in git_sections(ws_git.read_text(encoding="utf-8", errors="replace")) if ws_git.is_file()} if ws_git.is_file() else set()
                local_secs = git_sections(local_git.read_text(encoding="utf-8", errors="replace"))
                candidates = [
                    (h, t)
                    for h, t in local_secs
                    if not re.match(r"^include(?:\b|$)|^includeIf\b|^credential", h)
                    and text_hash(t) not in shared_hashes
                    and text_hash(t) not in ws_hashes
                ]
                if not candidates:
                    badge("OK", "green", "All local .gitconfig sections are accounted for.")
                else:
                    print(ctext(f"\nFound {len(candidates)} non-managed section(s) in {local_git}:", "yellow"))
                    for h, t in candidates:
                        print(ctext(f"  - [{h}]", "cyan"))
                        if self.args.what_if:
                            continue
                        if not interactive:
                            badge("ERROR", "red", f"Interactive session required to route git section [{h}].")
                            raise SystemExit(1)
                        choice = input(f"    Route [{h}] to: [S]hared, [W]orkspace ({workspace}), [L]ocal, [Q]uit: ").strip().upper()
                        if choice == "Q":
                            return
                        if choice == "S":
                            append_utf8_file(shared_git, t)
                            badge("ROUTED", "green", f"Added [{h}] -> {shared_git}")
                        elif choice == "W":
                            append_utf8_file(ws_git, t)
                            badge("ROUTED", "green", f"Added [{h}] -> {ws_git}")
                        else:
                            badge("KEEP", "darkgray", f"Kept [{h}] local.")

        if self.args.push and not self.args.what_if:
            host = os.environ.get("HOSTNAME") or os.uname().nodename if hasattr(os, "uname") else os.environ.get("COMPUTERNAME", "host")
            subprocess.run(["git", "-C", str(SCRIPT_DIR), "push", "--dry-run"], check=True)
            subprocess.run(["git", "-C", str(SCRIPT_DIR), "add", "-A"], check=True)
            subprocess.run(["git", "-C", str(SCRIPT_DIR), "commit", "-m", f"chore: bootstrap {workspace} configs from {host}"], check=True)
            subprocess.run(["git", "-C", str(SCRIPT_DIR), "push"], check=True)

    @staticmethod
    def filter_available_apt_packages(names: list[str]) -> tuple[list[str], list[str]]:
        """Partition apt package names into (available, missing) using apt-cache."""
        if not shutil.which("apt-cache"):
            return list(names), []
        available: list[str] = []
        missing: list[str] = []
        for pkg_name in names:
            res = subprocess.run(
                ["apt-cache", "show", pkg_name],
                capture_output=True,
                text=True,
                check=False,
            )
            if res.returncode == 0 and res.stdout.strip():
                available.append(pkg_name)
            else:
                missing.append(pkg_name)
        return available, missing

    def cmd_apps(self, workspace: str, sub: str) -> None:
        chain = set(self.get_workspace_chain(workspace))
        pkgs = [
            p for p in self.config.get("packages", [])
            if not p.get("workspaces") or any(w in chain for w in p["workspaces"])
        ]
        if sub in ("list", ""):
            print(ctext(f"\n=== Configured Applications ({workspace}) ===", "cyan"))
            for p in pkgs:
                arch = p.get("arch", "-")
                apt = p.get("apt", "-")
                print(f"  {p['name']:<32} arch={arch:<24} apt={apt}")
            print()
            return

        yay = shutil.which("yay") or shutil.which("paru")
        pacman = shutil.which("pacman")
        apt = shutil.which("apt-get")

        if sub == "install":
            if yay or pacman:
                installer = yay or pacman
                names = [p["arch"] for p in pkgs if p.get("arch")]
                if not yay:
                    print(ctext("Note: AUR helper (yay/paru) not found; installing official pacman packages only.", "yellow"))
                cmd = ([installer] if yay else ["sudo", pacman]) + ["-S", "--needed"] + names
                print(f"--> {' '.join(cmd)}")
                if not self.args.what_if:
                    subprocess.run(cmd)
            elif apt:
                names = [p["apt"] for p in pkgs if p.get("apt")]
                available, missing = self.filter_available_apt_packages(names)
                if missing:
                    badge("WARN", "yellow", f"Skipping unavailable apt package(s): {', '.join(missing)}")
                if available:
                    cmd = ["sudo", "apt-get", "install", "-y"] + available
                    print(f"--> {' '.join(cmd)}")
                    if not self.args.what_if:
                        subprocess.run(cmd)
                else:
                    badge("WARN", "yellow", "No configured apt packages are available in the current apt cache.")
            else:
                badge("WARN", "yellow", "No supported package manager (yay/paru/pacman/apt-get) found.")
        elif sub == "update":
            if yay:
                subprocess.run([yay, "-Syu"])
            elif pacman:
                subprocess.run(["sudo", pacman, "-Syu"])
            elif apt:
                subprocess.run(["sudo", "apt-get", "update"])
                subprocess.run(["sudo", "apt-get", "upgrade", "-y"])
            else:
                badge("WARN", "yellow", "No supported package manager found.")

    def run(self) -> int:
        action = (self.args.action or "status").lower()
        sub = (self.args.sub_action or "").lower()
        target = self.args.target_name

        actions_without_active = action == "workspace" and sub in ("", "list", "current", "use", "new")
        active_ws = self.get_active_workspace(prompt_if_missing=not actions_without_active)

        if active_ws:
            print(f"\n{ctext('[RIG] Active Workspace:', 'cyan')} {ctext(active_ws, 'green')}")

        if self.args.pull:
            print(ctext("\n=== Pulling Latest Changes From Git ===", "cyan"))
            subprocess.run(["git", "-C", str(SCRIPT_DIR), "pull"])

        if action == "workspace":
            ws_cmd = sub or "list"
            if ws_cmd == "list":
                print(ctext("\n=== Available Workspaces ===", "cyan"))
                for w in self.get_available_workspaces():
                    if w == active_ws:
                        print(ctext(f"  * {w} (active)", "green"))
                    else:
                        print(f"    {w}")
                print(ctext("\nSwitch workspace: rig workspace use <name>\n", "darkgray"))
            elif ws_cmd == "current":
                if active_ws:
                    print(f"\nActive workspace: {ctext(active_ws, 'green')}")
                    print(ctext(f"Path: {SCRIPT_DIR / 'workspaces' / active_ws}\n", "darkgray"))
                else:
                    print(ctext("\nNo active workspace configured. Run 'rig workspace use <name>'.\n", "yellow"))
            elif ws_cmd == "use":
                if not target:
                    badge("ERROR", "red", "Workspace name required: rig workspace use <name>")
                    return 1
                ws_norm = target.strip().lower()
                if self.args.what_if:
                    badge("WHAT-IF", "cyan", f"Would set active workspace to '{ws_norm}'")
                    if not self.args.no_apply:
                        self.cmd_apply(ws_norm)
                    return 0
                active_ws = self.set_active_workspace(ws_norm)
                if not self.args.no_apply:
                    self.cmd_apply(active_ws)
            elif ws_cmd == "new":
                if self.args.what_if:
                    badge("WHAT-IF", "cyan", f"Would create workspace '{target}'")
                    return 0
                self.new_workspace(target)
                if self.args.push and target:
                    subprocess.run(["git", "-C", str(SCRIPT_DIR), "add", "-A"], check=True)
                    subprocess.run(["git", "-C", str(SCRIPT_DIR), "commit", "-m", f"chore: add workspace {target}"], check=True)
                    subprocess.run(["git", "-C", str(SCRIPT_DIR), "push"], check=True)
            elif ws_cmd == "delete":
                if not target:
                    badge("ERROR", "red", "Workspace name required: rig workspace delete <name>")
                    return 1
                ws_del = target.strip().lower()
                if ws_del == active_ws:
                    badge("ERROR", "red", f"Cannot delete active workspace '{ws_del}'.")
                    return 1
                tdir = SCRIPT_DIR / self.config["workspacesDir"] / ws_del
                if not tdir.is_dir():
                    badge("WARN", "yellow", f"Workspace '{ws_del}' not found.")
                    return 0
                if self.args.what_if:
                    badge("WHAT-IF", "cyan", f"Would delete workspace '{ws_del}'")
                    return 0
                print(ctext(f"Command preview: rm -rf '{tdir}'", "yellow"))
                if not self.args.yes:
                    reply = input(f"Delete workspace '{ws_del}'? [y/N] ").strip().lower()
                    if reply not in ("y", "yes"):
                        badge("ABORTED", "darkgray", f"Workspace '{ws_del}' was not deleted.")
                        return 0
                shutil.rmtree(tdir)
                badge("DELETED", "green", f"Deleted workspace '{ws_del}'")
            else:
                badge("ERROR", "red", f"Unknown workspace command: {ws_cmd}")
                return 1
        elif action == "status":
            self.cmd_status(active_ws)
        elif action in ("apply", "link"):
            self.cmd_apply(active_ws)
        elif action == "diff":
            self.cmd_diff(active_ws)
        elif action == "edit":
            self.cmd_edit(active_ws, self.args.sub_action, target)
        elif action == "bootstrap":
            self.cmd_bootstrap(active_ws)
        elif action == "apps":
            self.cmd_apps(active_ws, sub)
        elif action in ("fonts", "setup"):
            script = SCRIPT_DIR / "scripts" / "setup-linux.sh"
            if not script.is_file():
                badge("ERROR", "red", f"Missing setup script: {script}")
                return 1
            cmd = ["sh", str(script)]
            if action == "fonts":
                cmd.append("--fonts-only")
            if self.args.what_if:
                cmd.append("--what-if")
            if self.args.force:
                cmd.append("--force")
            return subprocess.run(cmd).returncode
        else:
            badge("ERROR", "red", f"Unknown action: '{action}'. Run 'rig --help' for usage.")
            return 1
        return 0


def normalize_cli_flags(argv: list[str]) -> list[str]:
    """Supports both POSIX (--what-if) and PowerShell-style (-WhatIf) arguments cleanly."""
    flag_map = {
        "-force": "--force",
        "-yes": "--yes",
        "-whatif": "--what-if",
        "-nobackup": "--no-backup",
        "-noapply": "--no-apply",
        "-push": "--push",
        "-pull": "--pull",
        "-pathonly": "--path-only",
        "-include": "--include",
        "-exclude": "--exclude",
        "-homeoverride": "--home-override",
        "-statehomeoverride": "--state-home-override",
        "-help": "--help",
    }
    return [flag_map.get(tok.lower(), tok) for tok in argv]


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="rig",
        description="Personal Settings Sync (RIG) — Zsh, Starship, Git, and AI configuration manager.",
    )
    parser.add_argument("action", nargs="?", default="status", help="status|apply|link|diff|edit|bootstrap|workspace|apps|fonts|setup")
    parser.add_argument("sub_action", nargs="?", help="Sub-action (e.g. workspace subcommand or edit layer)")
    parser.add_argument("target_name", nargs="?", help="Target workspace or edit item")
    parser.add_argument("--include", action="append", help="Filter subsystems: zsh, starship, git, gemini, skills, plugins")
    parser.add_argument("--exclude", action="append", help="Exclude specific subsystems")
    parser.add_argument("--pull", action="store_true", help="Run git pull before applying")
    parser.add_argument("--push", action="store_true", help="Commit and push after mutations")
    parser.add_argument("--force", "-f", action="store_true", help="Force overwrite or relink")
    parser.add_argument("--yes", "-y", action="store_true", help="Skip confirmation prompts")
    parser.add_argument("--what-if", "--whatif", action="store_true", help="Dry run without writing to disk")
    parser.add_argument("--no-backup", "--nobackup", action="store_true", help="Skip .backups/ snapshots")
    parser.add_argument("--no-apply", "--noapply", action="store_true", help="Skip automatic apply on workspace use")
    parser.add_argument("--path-only", action="store_true", help="Print resolved repo path for 'rig edit'")
    parser.add_argument("--home-override", help=argparse.SUPPRESS)
    parser.add_argument("--state-home-override", help=argparse.SUPPRESS)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args(normalize_cli_flags(sys.argv[1:]))
    return PssApp(args).run()


if __name__ == "__main__":
    raise SystemExit(main())
