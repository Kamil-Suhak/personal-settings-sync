#!/usr/bin/env python3
"""Personal Settings Sync (RIG) — Repo-as-source-of-truth environment manager."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR / "scripts"))

import local_state  # noqa: E402
import profile_groups  # noqa: E402

VALID_SUBSYSTEMS = ("zsh", "starship", "git", "gemini", "skills", "plugins")
MAX_BACKUPS = 10

COLORS = {
    "cyan": "\033[36m",
    "darkcyan": "\033[36m",
    "green": "\033[32m",
    "yellow": "\033[33m",
    "darkyellow": "\033[33m",
    "red": "\033[31m",
    "magenta": "\033[35m",
    "darkgray": "\033[90m",
    "white": "\033[37m",
    "reset": "\033[0m",
}


def ctext(text: str, color: str | None = None) -> str:
    if not color or color.lower() not in COLORS:
        return text
    return f"{COLORS[color.lower()]}{text}{COLORS['reset']}"


def badge(tag: str, tag_color: str, msg: str, msg_color: str | None = None) -> None:
    print(f"{ctext(f'[{tag}]', tag_color)} {ctext(msg, msg_color)}")


def normalize_lf(text: str | None) -> str:
    if text is None:
        return ""
    return text.replace("\r\n", "\n").rstrip("\r\n")


def text_hash(text: str) -> str:
    return hashlib.sha256(normalize_lf(text).encode("utf-8")).hexdigest()


def file_hash_safe(path: Path) -> str | None:
    if not path.is_file():
        return None
    return text_hash(path.read_text(encoding="utf-8", errors="replace"))


def write_utf8_file(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    normalized = normalize_lf(content) + "\n"
    path.write_text(normalized, encoding="utf-8", newline="\n")


def append_utf8_file(path: Path, content: str) -> None:
    existing = normalize_lf(path.read_text(encoding="utf-8", errors="replace")) if path.is_file() else ""
    new_part = normalize_lf(content)
    combined = f"{existing}\n\n{new_part}" if existing else new_part
    write_utf8_file(path, combined)


def to_forward_path(path: str | Path) -> str:
    return str(path).replace("\\", "/")


def is_link(path: Path) -> bool:
    if path.is_symlink():
        return True
    is_junc = getattr(os.path, "isjunction", None)
    if callable(is_junc) and is_junc(path):
        return True
    return False


def get_link_target(path: Path) -> str | None:
    if not is_link(path):
        return None
    try:
        raw = os.readlink(path)
        if os.name == "nt":
            if raw.startswith("\\\\?\\UNC\\"):
                raw = "\\\\" + raw[8:]
            elif raw.startswith("\\\\?\\") or raw.startswith("\\??\\"):
                raw = raw[4:]
        target = Path(raw)
        if not target.is_absolute():
            target = path.parent / target
        return os.path.abspath(str(target))
    except OSError:
        return ""


def paths_equal(a: str | Path, b: str | Path) -> bool:
    return os.path.normcase(os.path.abspath(str(a))) == os.path.normcase(os.path.abspath(str(b)))


def get_link_status(source: Path, target: Path) -> str:
    if not os.path.lexists(target):
        return "Missing on Machine"
    if is_link(target):
        cur = get_link_target(target)
        if not cur:
            return "Stale Link"
        if paths_equal(cur, source):
            return "Linked"
        return "Stale Link"
    if source.is_file() and target.is_file():
        try:
            if os.path.samefile(source, target):
                return "Linked"
        except OSError:
            pass
        return "File (Not Linked)"
    return "Directory (Not Linked)"


def remove_existing_target(target: Path, backup_root: Path | None, backup_rel: str, no_backup: bool) -> None:
    if not os.path.lexists(target):
        return
    if is_link(target):
        if os.name == "nt" and target.is_dir():
            os.rmdir(target)
        else:
            target.unlink()
        return

    if backup_root and not no_backup:
        dest = backup_root / backup_rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        if target.is_dir():
            shutil.copytree(target, dest, symlinks=True, dirs_exist_ok=True)
        else:
            shutil.copy2(target, dest)
        try:
            rel = dest.relative_to(SCRIPT_DIR)
        except ValueError:
            rel = dest
        badge("BACKUP", "darkcyan", f"Backed up -> {rel}")

    if target.is_dir():
        shutil.rmtree(target)
    else:
        target.unlink()


def create_link(source: Path, target: Path) -> None:
    target.parent.mkdir(parents=True, exist_ok=True)
    is_dir = source.is_dir()
    try:
        os.symlink(source, target, target_is_directory=is_dir)
    except OSError:
        if os.name != "nt":
            raise
        if is_dir:
            res = subprocess.run(
                ["cmd", "/d", "/c", "mklink", "/J", str(target), str(source)],
                capture_output=True,
                text=True,
            )
            if res.returncode != 0:
                raise RuntimeError(f"mklink /J failed: {res.stderr or res.stdout}")
        else:
            try:
                os.link(source, target)
            except OSError:
                shutil.copy2(source, target)


def prune_backups() -> None:
    backups_root = SCRIPT_DIR / ".backups"
    if not backups_root.is_dir():
        return
    dirs = sorted([d for d in backups_root.iterdir() if d.is_dir()], key=lambda p: p.name, reverse=True)
    if len(dirs) > MAX_BACKUPS:
        to_remove = dirs[MAX_BACKUPS:]
        for old in to_remove:
            shutil.rmtree(old, ignore_errors=True)
        badge("CLEANUP", "darkgray", f"Pruned {len(to_remove)} old backup folder(s).")


class PssApp:
    def __init__(self, args: argparse.Namespace) -> None:
        self.args = args
        config_file = SCRIPT_DIR / "sync.config.json"
        if not config_file.is_file():
            badge("ERROR", "red", f"Configuration file missing at: {config_file}")
            raise SystemExit(1)
        self.config = json.loads(config_file.read_text(encoding="utf-8"))

        self.home_dir = Path(args.home_override).resolve() if args.home_override else Path.home()
        self.local_paths = local_state.get_local_state_paths(
            SCRIPT_DIR,
            state_home=args.state_home_override,
            home_dir=self.home_dir,
        )
        local_state.migrate_legacy_local_state(
            self.local_paths,
            SCRIPT_DIR,
            home_dir=self.home_dir,
            what_if=args.what_if,
        )

        self.workspace_file = self.local_paths["workspace"]
        legacy_ws_file = SCRIPT_DIR / ".workspace.local"
        if args.what_if and not self.workspace_file.is_file() and legacy_ws_file.is_file():
            self.workspace_file = legacy_ws_file

        self.included = self._parse_subsystems(args.include)
        self.excluded = self._parse_subsystems(args.exclude)
        self.timestamp = datetime.now().strftime("%Y%m%d-%H%M%S")
        self.backup_dir = SCRIPT_DIR / ".backups" / self.timestamp

    def _parse_subsystems(self, items: list[str] | None) -> set[str]:
        result: set[str] = set()
        for item in items or []:
            for part in re.split(r"[,;]", item):
                cleaned = part.strip().lower()
                if not cleaned:
                    continue
                if cleaned not in VALID_SUBSYSTEMS:
                    badge("ERROR", "red", f"Invalid subsystem '{cleaned}'. Valid: {', '.join(VALID_SUBSYSTEMS)}")
                    raise SystemExit(1)
                result.add(cleaned)
        return result

    def should_process(self, subsystem: str) -> bool:
        name = subsystem.lower()
        if name in self.excluded:
            return False
        if self.included and name not in self.included:
            return False
        return True

    def resolve_dynamic_path(self, pattern: str) -> Path:
        home_str = str(self.home_dir)
        resolved = pattern
        if resolved == "~":
            resolved = home_str
        elif resolved.startswith("~/") or resolved.startswith("~\\"):
            resolved = os.path.join(home_str, resolved[2:])
        resolved = resolved.replace("%USERPROFILE%", home_str).replace("$HOME", home_str)
        resolved = os.path.expandvars(resolved)
        return Path(os.path.abspath(resolved))

    def get_available_workspaces(self) -> list[str]:
        ws_dir = SCRIPT_DIR / self.config["workspacesDir"]
        if not ws_dir.is_dir():
            return [self.config["defaultWorkspace"]]
        dirs = sorted([d.name for d in ws_dir.iterdir() if d.is_dir()])
        return dirs or [self.config["defaultWorkspace"]]

    def new_workspace(self, name: str | None) -> None:
        if not name:
            badge("ERROR", "red", "Workspace name required: rig workspace new <name>")
            raise SystemExit(1)
        ws_name = name.strip().lower()
        ws_path = SCRIPT_DIR / self.config["workspacesDir"] / ws_name
        if ws_path.is_dir():
            badge("WARN", "yellow", f"Workspace '{ws_name}' already exists at workspaces/{ws_name}")
            return
        for sub in ("zsh", "git", "gemini"):
            (ws_path / sub).mkdir(parents=True, exist_ok=True)
        write_utf8_file(ws_path / "zsh" / "profile.zsh", f"# Zsh overrides for workspace: {ws_name}")
        write_utf8_file(
            ws_path / "git" / ".gitconfig",
            f"# Git overrides for workspace: {ws_name}\n[user]\n\t# email = user@{ws_name}.local",
        )
        cap = ws_name[0].upper() + ws_name[1:]
        write_utf8_file(ws_path / "gemini" / "AGENTS.md", f"## {cap} Workspace Context")
        badge("CREATED", "green", f"Created workspace '{ws_name}' in workspaces/{ws_name}")

    def set_active_workspace(self, name: str | None) -> str:
        if not name:
            badge("ERROR", "red", "Workspace name required: rig workspace use <name>")
            raise SystemExit(1)
        ws_name = name.strip().lower()
        ws_path = SCRIPT_DIR / self.config["workspacesDir"] / ws_name
        if not ws_path.is_dir():
            self.new_workspace(ws_name)
        write_utf8_file(self.workspace_file, ws_name)
        badge("ACTIVE", "green", f"Active workspace set to: {ws_name}")
        return ws_name

    def get_active_workspace(self, prompt_if_missing: bool = True) -> str:
        if self.workspace_file.is_file():
            active = self.workspace_file.read_text(encoding="utf-8", errors="replace").strip()
            if active:
                return active
        if not prompt_if_missing:
            return ""
        available = self.get_available_workspaces()
        if not sys.stdin.isatty():
            badge("ERROR", "red", "No active workspace configured. Run 'rig workspace use <name>' first.")
            raise SystemExit(1)
        print(ctext("\n=== First-Run Workspace Selection ===", "cyan"))
        print(f"Available workspaces: {', '.join(available)}")
        sel = input(f"Enter workspace to use (default: '{available[0]}'): ").strip() or available[0]
        return self.set_active_workspace(sel)

    # --- Subsystem Computations ---

    def expected_zsh_loader(self) -> str:
        shared_init = Path(os.path.abspath(SCRIPT_DIR / self.config["subsystems"]["zsh"]["sharedPath"]))
        return (
            "# Managed by rig (rig). Edit files in the repository, not here.\n"
            f'source "{to_forward_path(shared_init)}"'
        )

    def is_managed_zsh_loader(self, local_path: Path) -> bool:
        if not local_path.is_file():
            return False
        raw = local_path.read_text(encoding="utf-8", errors="replace")
        return bool(re.search(r"(?m)^#\s*Managed by rig \(rig\)", raw))

    def get_zsh_status(self) -> dict:
        local_path = self.resolve_dynamic_path(self.config["subsystems"]["zsh"]["localTarget"])
        expected = self.expected_zsh_loader()
        if not local_path.is_file():
            return {"status": "Missing on Machine", "local_path": local_path, "expected": expected}
        local_text = local_path.read_text(encoding="utf-8", errors="replace")
        if text_hash(local_text) == text_hash(expected):
            return {"status": "In Sync", "local_path": local_path, "expected": expected}
        if self.is_managed_zsh_loader(local_path):
            return {"status": "Needs Relink", "local_path": local_path, "expected": expected}
        return {"status": "Unmanaged Local File", "local_path": local_path, "expected": expected}

    def get_starship_link(self) -> dict:
        cfg = self.config["subsystems"]["starship"]
        return {
            "name": "starship.toml",
            "source": SCRIPT_DIR / cfg["sharedPath"],
            "target": self.resolve_dynamic_path(cfg["localTarget"]),
        }

    def get_workspace_chain(self, workspace: str) -> list[str]:
        return profile_groups.resolve_workspace_chain(SCRIPT_DIR, workspace)

    def get_git_include_targets(self, workspace: str) -> list[str]:
        git_cfg = self.config["subsystems"]["git"]
        shared_abs = to_forward_path(SCRIPT_DIR / git_cfg["sharedPath"])
        targets = [shared_abs]
        for ws in self.get_workspace_chain(workspace):
            ws_rel = git_cfg["workspacePath"].replace("{workspace}", ws)
            ws_file = SCRIPT_DIR / ws_rel
            if ws_file.is_file():
                targets.append(to_forward_path(ws_file))
        return targets

    @staticmethod
    def unquote_git_include_value(raw_val: str) -> str:
        val = raw_val.strip()
        m1 = re.match(r'^"([^"]+)"(?:\s*[#;].*)?$', val)
        m2 = re.match(r"^'([^']+)'(?:\s*[#;].*)?$", val)
        if m1:
            val = m1.group(1)
        elif m2:
            val = m2.group(1)
        else:
            val = re.split(r"\s+[#;]", val, maxsplit=1)[0].strip()
        return to_forward_path(val)

    @classmethod
    def is_rig_managed_git_include(cls, include_path: str) -> bool:
        norm = cls.unquote_git_include_value(include_path)
        return (
            norm in ("~/.gitconfig.shared", "~/.gitconfig.workspace", "~/.gitconfig.local")
            or bool(re.search(r"/configs/git/\.gitconfig\.shared$", norm))
            or bool(re.search(r"/workspaces/[^/]+/git/\.gitconfig$", norm))
        )

    @classmethod
    def build_updated_gitconfig(cls, existing: str, desired_includes: list[str]) -> str:
        lines = normalize_lf(existing).split("\n") if existing else []
        kept: list[str] = []
        i = 0
        while i < len(lines):
            line = lines[i]
            if re.match(r"^\s*\[include\]\s*(?:[#;].*)?$", line):
                section_body: list[str] = []
                j = i + 1
                while j < len(lines) and not re.match(r"^\s*\[", lines[j]):
                    body_line = lines[j]
                    m = re.match(r"^\s*path\s*=\s*(.+)$", body_line)
                    if m:
                        if not cls.is_rig_managed_git_include(m.group(1)):
                            section_body.append(body_line)
                    elif body_line.strip() != "":
                        section_body.append(body_line)
                    j += 1
                if section_body:
                    kept.append(line)
                    kept.extend(section_body)
                i = j
                continue
            kept.append(line)
            i += 1

        header: list[str] = []
        for inc in desired_includes:
            formatted = f'"{inc}"' if re.search(r"\s", inc) else inc
            header.append("[include]")
            header.append(f"\tpath = {formatted}")

        body = "\n".join(kept).lstrip("\n")
        if body:
            return "\n".join(header) + "\n" + body
        return "\n".join(header)

    def get_git_config_status(self, workspace: str) -> dict:
        local_path = self.resolve_dynamic_path(self.config["subsystems"]["git"]["localTarget"])
        desired = self.get_git_include_targets(workspace)
        if not local_path.is_file():
            return {"status": "Missing on Machine", "local_path": local_path, "desired": desired}
        raw = local_path.read_text(encoding="utf-8", errors="replace")
        expected = self.build_updated_gitconfig(raw, desired)
        status = "In Sync" if text_hash(raw) == text_hash(expected) else "Needs Update"
        return {"status": status, "local_path": local_path, "desired": desired}

    def get_git_hooks_link(self) -> dict | None:
        git_cfg = self.config["subsystems"]["git"]
        if not git_cfg.get("hooksDir") or not git_cfg.get("hooksTarget"):
            return None
        src = SCRIPT_DIR / git_cfg["hooksDir"]
        if not src.is_dir():
            return None
        return {
            "name": "git-hooks",
            "source": src,
            "target": self.resolve_dynamic_path(git_cfg["hooksTarget"]),
        }

    def expected_gemini_content(self, file_entry: dict, workspace: str) -> str | None:
        repo_abs = SCRIPT_DIR / file_entry["repoPath"]
        if not repo_abs.is_file():
            return None
        shared_raw = normalize_lf(repo_abs.read_text(encoding="utf-8", errors="replace"))
        chain = self.get_workspace_chain(workspace)
        if file_entry.get("mode") == "template":
            home_fwd = to_forward_path(self.home_dir)
            repo_fwd = to_forward_path(SCRIPT_DIR)
            expanded = shared_raw.replace("~/", f"{home_fwd}/").replace("{REPO}", repo_fwd)
            if file_entry["name"] == "skills.json":
                extra_entries: list[dict] = []
                for ws in reversed(chain):
                    ws_skills_dir = SCRIPT_DIR / "workspaces" / ws / "skills"
                    if ws_skills_dir.is_dir():
                        extra_entries.append({"path": to_forward_path(ws_skills_dir)})
                if extra_entries:
                    parsed = json.loads(expanded)
                    extra_paths = {e["path"] for e in extra_entries}
                    parsed["entries"] = extra_entries + [
                        e for e in parsed.get("entries", []) if e.get("path") not in extra_paths
                    ]
                    expanded = json.dumps(parsed, indent=2)
            return expanded

        parts: list[str] = []
        if file_entry["name"] == "AGENTS.md":
            parts.append(
                f"<!-- Managed by rig (shared + {' + '.join(chain)}). Edit repo files, not this output. -->"
            )
        parts.append(shared_raw)
        if file_entry.get("workspacePath"):
            for ws in chain:
                ws_rel = file_entry["workspacePath"].replace("{workspace}", ws)
                ws_abs = SCRIPT_DIR / ws_rel
                if ws_abs.is_file():
                    ws_raw = normalize_lf(ws_abs.read_text(encoding="utf-8", errors="replace")).strip()
                    if ws_raw:
                        parts.append(ws_raw)
        return "\n\n".join(parts)

    def get_desired_skill_links(self, workspace: str) -> list[dict]:
        cfg = self.config["subsystems"]["skills"]
        target_base = self.resolve_dynamic_path(cfg["targetDir"])
        shared_base = SCRIPT_DIR / cfg["repoDir"]
        ws_dir_tpl = cfg.get("workspaceDir")
        chain = self.get_workspace_chain(workspace)

        links: list[dict] = []
        seen: set[str] = set()
        if ws_dir_tpl:
            for ws in reversed(chain):
                ws_base = SCRIPT_DIR / ws_dir_tpl.replace("{workspace}", ws)
                if ws_base.is_dir():
                    for d in sorted(ws_base.iterdir(), key=lambda p: p.name):
                        if d.is_dir() and d.name.lower() not in seen:
                            seen.add(d.name.lower())
                            links.append({"name": d.name, "source": d, "target": target_base / d.name})

        for name in cfg.get("items", []):
            if name.lower() in seen:
                continue
            src = shared_base / name
            if src.is_dir():
                seen.add(name.lower())
                links.append({"name": name, "source": src, "target": target_base / name})

        for mirror in cfg.get("mirrorLinks", []):
            if mirror:
                links.append({"name": "skills-mirror", "source": target_base, "target": self.resolve_dynamic_path(mirror)})
        return links

    def get_desired_plugin_links(self) -> list[dict]:
        cfg = self.config["subsystems"]["plugins"]
        target_base = self.resolve_dynamic_path(cfg["targetDir"])
        shared_base = SCRIPT_DIR / cfg["repoDir"]
        links: list[dict] = []
        for name in cfg.get("items", []):
            src = shared_base / name
            if src.is_dir():
                links.append({"name": name, "source": src, "target": target_base / name})
        return links

    def sync_link(self, source: Path, target: Path, backup_rel: str) -> bool:
        state = get_link_status(source, target)
        if state == "Linked" and not self.args.force:
            badge("OK", "darkgray", f"Already linked: {target} -> {source}")
            return False
        if self.args.what_if:
            badge("WHAT-IF", "cyan", f"Would link {target} -> {source} (current: {state})")
            return False
        remove_existing_target(target, self.backup_dir, backup_rel, self.args.no_backup)
        create_link(source, target)
        badge("LINKED", "green", f"{target} -> {source}")
        return True

    # --- Primary Actions ---

    def cmd_status(self, workspace: str) -> None:
        print(ctext("\n=== Personal Settings Sync Status ===", "cyan"))
        rows: list[tuple[str, str, str, str, str]] = []

        if self.should_process("zsh"):
            st = self.get_zsh_status()
            rows.append(("Zsh", "Profile Loader", "Loader", st["status"], str(st["local_path"])))

        if self.should_process("starship"):
            sl = self.get_starship_link()
            rows.append(("Starship", sl["name"], "Symlink", get_link_status(sl["source"], sl["target"]), str(sl["target"])))

        if self.should_process("git"):
            gs = self.get_git_config_status(workspace)
            rows.append(("Git", ".gitconfig", "Include", gs["status"], str(gs["local_path"])))
            hl = self.get_git_hooks_link()
            if hl:
                rows.append(("Git", ".git-hooks", "Symlink", get_link_status(hl["source"], hl["target"]), str(hl["target"])))

        if self.should_process("gemini"):
            for f in self.config["subsystems"]["gemini"]["files"]:
                lp = self.resolve_dynamic_path(f["localPath"])
                exp = self.expected_gemini_content(f, workspace)
                if exp is None:
                    continue
                if not lp.is_file():
                    status = "Missing on Machine"
                elif file_hash_safe(lp) == text_hash(exp):
                    status = "In Sync"
                else:
                    status = "Modified"
                rows.append(("AI Rules", f["name"], f["mode"], status, str(lp)))

        if self.should_process("skills"):
            for link in self.get_desired_skill_links(workspace):
                rows.append(("AI Skill", link["name"], "Symlink", get_link_status(link["source"], link["target"]), str(link["target"])))

        if self.should_process("plugins"):
            for link in self.get_desired_plugin_links():
                rows.append(("AI Plugin", link["name"], "Symlink", get_link_status(link["source"], link["target"]), str(link["target"])))

        headers = ("Subsystem", "Target", "Mode", "Status", "Path")
        widths = [max(len(headers[i]), *(len(r[i]) for r in rows)) for i in range(5)] if rows else [len(h) for h in headers]
        fmt = "  ".join(f"{{:<{w}}}" for w in widths)
        print(fmt.format(*headers))
        print(fmt.format(*("-" * w for w in widths)))
        for r in rows:
            print(fmt.format(*r))
        print()

    def cmd_apply(self, workspace: str) -> None:
        print(ctext(f"\n=== Applying Settings (Repo -> Machine: {workspace}) ===", "cyan"))
        applied = 0

        if self.should_process("zsh"):
            print(ctext("\n[Zsh Profile]", "yellow"))
            st = self.get_zsh_status()
            if st["status"] == "In Sync" and not self.args.force:
                badge("OK", "darkgray", f"Already linked: {st['local_path']}")
            elif self.args.what_if:
                badge("WHAT-IF", "cyan", f"Would write profile loader -> {st['local_path']}")
            else:
                if st["local_path"].is_file() and not self.is_managed_zsh_loader(st["local_path"]):
                    remove_existing_target(st["local_path"], self.backup_dir, "zsh/.zshrc", self.args.no_backup)
