#!/usr/bin/env python3
"""Manage named cross-repository issue file sets ('worksets') backed by Obsidian markdown notes."""

from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
import uuid
from pathlib import Path

BIN_COMMON_DIR = Path(__file__).resolve().parent
SCRIPTS_DIR = Path(__file__).resolve().parents[2] / "scripts"
sys.path.insert(0, str(BIN_COMMON_DIR))
sys.path.insert(0, str(SCRIPTS_DIR))

from _rig_common import (  # noqa: E402
    ctext,
    normalize_legacy_flags,
    read_config_lines,
    resolve_project_roots_file,
    resolve_rig_root,
    resolve_state_home,
    resolve_workspace_vault,
    resolve_workset_config,
    run_git,
)
from local_state import get_local_state_paths  # noqa: E402

RESERVED_WIN_RE = re.compile(r"^(con|prn|aux|nul|com[1-9]|lpt[1-9])(\.|$)", re.IGNORECASE)
VALID_ACTIONS = ("new", "add", "rm", "edit", "show", "list", "open", "gh", "archive", "restore", "delete")


def convert_to_workset_name(name: str) -> str:
    """Normalize a workset identifier into a safe filename stem."""
    step1 = re.sub(r"[^a-z0-9._-]+", "-", name.strip().lower())
    normalized = re.sub(r"-+", "-", step1).strip(" .-")
    if not normalized or len(normalized) > 100 or RESERVED_WIN_RE.match(normalized):
        raise ValueError(f"Invalid workset name '{name}'; choose a valid name up to 100 characters.")
    return normalized


def _resolve_active_workspace(rig_root: Path) -> str:
    if os.environ.get("RIG_WORKSPACE"):
        return os.environ["RIG_WORKSPACE"].strip()
    ws_file = get_local_state_paths(rig_root, state_home=resolve_state_home())["workspace"]
    if ws_file.is_file():
        val = ws_file.read_text(encoding="utf-8", errors="replace").strip()
        if val:
            return val
    return "personal"


def _workset_env() -> tuple[Path, str, Path, dict]:
    rig_root = resolve_rig_root()
    ws_name = _resolve_active_workspace(rig_root)
    vault = resolve_workspace_vault(rig_root, ws_name)
    cfg = resolve_workset_config(rig_root, ws_name)
    return rig_root, ws_name, vault, cfg


def get_workset_context(directory: Path | None = None) -> tuple[str, str | None] | None:
    target = directory or Path.cwd()
    root_res = run_git(["rev-parse", "--show-toplevel"], cwd=target)
    if root_res.returncode != 0 or not root_res.stdout.strip():
        return None
    root_path = str(Path(root_res.stdout.strip()).resolve())
    branch_res = run_git(["symbolic-ref", "--quiet", "--short", "HEAD"], cwd=target)
    branch = branch_res.stdout.strip() if branch_res.returncode == 0 and branch_res.stdout.strip() else None
    return root_path, branch


def _parse_frontmatter(text: str) -> tuple[dict, str]:
    """Parse simple YAML frontmatter (`---` delimited) and return (metadata, body)."""
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return {}, text
    end_idx = None
    for idx in range(1, len(lines)):
        if lines[idx].strip() == "---":
            end_idx = idx
            break
    if end_idx is None:
        return {}, text

    meta: dict = {}
    repos: list[dict] = []
    in_repos = False
    current_repo: dict | None = None

    for raw in lines[1:end_idx]:
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if raw.startswith("  - ") and in_repos:
            if current_repo:
                repos.append(current_repo)
            current_repo = {}
            rest = raw[4:].strip()
            if ":" in rest:
                k, v = rest.split(":", 1)
                current_repo[k.strip()] = v.strip().strip("'\"")
            continue
        if raw.startswith("    ") and in_repos and current_repo is not None:
            if ":" in stripped:
                k, v = stripped.split(":", 1)
                current_repo[k.strip()] = v.strip().strip("'\"")
            continue

        if in_repos and current_repo is not None:
            repos.append(current_repo)
            current_repo = None
        in_repos = False

        if ":" in stripped:
            k, v = stripped.split(":", 1)
            key = k.strip()
            val = v.strip().strip("'\"")
            if key == "repositories":
                in_repos = True
                if val == "[]":
                    repos = []
            else:
                meta[key] = None if val in ("", "null", "~") else val

    if in_repos and current_repo is not None:
        repos.append(current_repo)
    if repos or "repositories" in text:
        meta.setdefault("repositories", repos)

    body = "\n".join(lines[end_idx + 1 :]).lstrip("\n")
    return meta, body


def _dump_frontmatter(meta: dict) -> str:
    """Serialize workset metadata dict to YAML frontmatter."""
    out = ["---", f"type: {meta.get('type', 'workset')}"]
    for key in ("name", "status", "issue_url", "originRoot", "branch"):
        val = meta.get(key)
        out.append(f"{key}: {val if val else ''}".rstrip())
    repos = meta.get("repositories") or []
    if not repos:
        out.append("repositories: []")
    else:
        out.append("repositories:")
        for repo in repos:
            if not isinstance(repo, dict):
                continue
            out.append(f"  - root: {repo.get('root', '')}")
            if repo.get("name"):
                out.append(f"    name: {repo['name']}")
            if repo.get("branch"):
                out.append(f"    branch: {repo['branch']}")
    out.append("---")
    return "\n".join(out)


def _extract_files_section(body: str) -> list[str]:
    lines = body.splitlines()
    in_files = False
    entries: list[str] = []
    for raw in lines:
        s = raw.strip()
        if s.startswith("## "):
            if s.lower() == "## files":
                in_files = True
                continue
            if in_files:
                break
        if in_files and s.startswith("- "):
            item = s[2:].strip()
            if item.startswith("`") and item.endswith("`") and len(item) >= 2:
                item = item[1:-1]
            if item:
                entries.append(item)
    return entries


def _replace_files_section(body: str, entries: list[str]) -> str:
    lines = body.splitlines()
    out: list[str] = []
    in_files = False
    replaced = False

    def _emit_entries() -> None:
        for e in entries:
            out.append(f"- `{e}`")

    for raw in lines:
        s = raw.strip()
        if s.startswith("## "):
            if in_files:
                in_files = False
            if s.lower() == "## files":
                out.append(raw)
                _emit_entries()
                in_files = True
                replaced = True
                continue
        if in_files:
            continue
        out.append(raw)

    if not replaced:
        if out and out[-1].strip():
            out.append("")
        out.append("## Files")
        _emit_entries()

    return "\n".join(out).rstrip() + "\n"


def _render_workset_note(
    name: str,
    *,
    parent_note: str,
    status: str,
    issue_url: str,
    origin_root: str | None,
    branch: str | None,
    repositories: list[dict],
    files: list[str],
) -> str:
    meta = {
        "type": "workset",
        "name": name,
        "status": status,
        "issue_url": issue_url,
        "originRoot": origin_root,
        "branch": branch,
        "repositories": repositories,
    }
    file_lines = "\n".join(f"- `{f}`" for f in files)
    body = (
        f"# {name}\n\n"
        f"Parent: [[{parent_note}]]\n\n"
        f"## Files\n"
        f"{file_lines + chr(10) if file_lines else ''}"
        f"\n## Overview & WIP\n\n\n"
        f"## Team Questions / Concerns\n"
    )
    return _dump_frontmatter(meta) + "\n" + body


def _is_workset_note(path: Path) -> bool:
    if not path.is_file() or path.suffix.lower() != ".md" or path.name.startswith(".new-"):
        return False
    try:
        head = path.read_text(encoding="utf-8", errors="replace")[:512]
    except OSError:
        return False
    meta, _ = _parse_frontmatter(head)
    return meta.get("type") == "workset"


def _iter_workset_notes(*, archived: bool = False) -> list[Path]:
    env_root = os.environ.get("RIG_WORKSETS_ROOT")
    if env_root:
        sub = "archived" if archived else "active"
        base = Path(env_root).expanduser() / sub
        if not base.is_dir():
            return []
        return sorted((p for p in base.glob("*.md") if _is_workset_note(p)), key=lambda p: p.stem.lower())

    _rig_root, _ws, vault, cfg = _workset_env()
    if cfg.get("dir_mode") == "per_project":
        projects_dir = vault / "wiki" / "Projects"
        if not projects_dir.is_dir():
            return []
        notes: list[Path] = []
        for proj_dir in projects_dir.iterdir():
            if not proj_dir.is_dir():
                continue
            target_dir = (proj_dir / "archived") if archived else proj_dir
            if not target_dir.is_dir():
                continue
            for p in target_dir.glob("*.md"):
                if _is_workset_note(p):
                    notes.append(p)
        return sorted(notes, key=lambda p: p.stem.lower())

    base = vault / "wiki" / "Worksets"
    target_dir = (base / "archived") if archived else base
    if not target_dir.is_dir():
        return []
    return sorted((p for p in target_dir.glob("*.md") if _is_workset_note(p)), key=lambda p: p.stem.lower())


def _target_note_path(name: str, *, parent_note: str, archived: bool = False) -> Path:
    norm = convert_to_workset_name(name)
    env_root = os.environ.get("RIG_WORKSETS_ROOT")
    if env_root:
        sub = "archived" if archived else "active"
        return Path(env_root).expanduser() / sub / f"{norm}.md"

    _rig_root, _ws, vault, cfg = _workset_env()
    if cfg.get("dir_mode") == "per_project":
        proj_dir = vault / "wiki" / "Projects" / parent_note
        return (proj_dir / "archived" / f"{norm}.md") if archived else (proj_dir / f"{norm}.md")

    base = vault / "wiki" / "Worksets"
    return (base / "archived" / f"{norm}.md") if archived else (base / f"{norm}.md")


def _archived_counterpart(note_path: Path, *, to_archived: bool) -> Path:
    if to_archived:
        if os.environ.get("RIG_WORKSETS_ROOT"):
            return note_path.parent.parent / "archived" / note_path.name
        return note_path.parent / "archived" / note_path.name
    if os.environ.get("RIG_WORKSETS_ROOT"):
        return note_path.parent.parent / "active" / note_path.name
    return note_path.parent.parent / note_path.name


def _repo_matches(meta: dict, root: str, branch: str) -> bool:
    if meta.get("originRoot") == root and meta.get("branch") == branch:
        return True
    for repo in meta.get("repositories") or []:
        if isinstance(repo, dict) and repo.get("root") == root and repo.get("branch") == branch:
            return True
    return False


def find_matching_worksets(root: str, branch: str, *, archived: bool = False) -> list[Path]:
    if not root or not branch:
        return []
    matches: list[Path] = []
    for note in _iter_workset_notes(archived=archived):
        meta, _ = _parse_frontmatter(note.read_text(encoding="utf-8", errors="replace"))
        if _repo_matches(meta, root, branch):
            matches.append(note)
    return matches


def get_current_workset_name(root: str, branch: str) -> str | None:
    matches = find_matching_worksets(root, branch, archived=False)
    return matches[0].stem if len(matches) == 1 else None


def get_current_workset_badge(root: str, branch: str) -> str | None:
    matches = find_matching_worksets(root, branch, archived=False)
    if len(matches) != 1:
        return None
    note = matches[0]
    text = note.read_text(encoding="utf-8", errors="replace")
    _, body = _parse_frontmatter(text)
    count = len(_extract_files_section(body))
    norm_branch = ""
    if branch:
        try:
            norm_branch = convert_to_workset_name(branch)
        except ValueError:
            norm_branch = ""
    if norm_branch and note.stem == norm_branch:
        return f"✦{count}"
    return f"{note.stem} ✦{count}"


def _select_workset_with_fzf(*, archived: bool = False) -> Path | None:
    notes = _iter_workset_notes(archived=archived)
    if not notes:
        return None
    if not shutil.which("fzf") or not sys.stdin.isatty():
        return None
    names = "\n".join(n.stem for n in notes)
    res = subprocess.run(
        ["fzf", "--height", "40%", "--reverse", "--prompt=workset> "],
        input=names,
        text=True,
        capture_output=True,
        check=False,
    )
    if res.returncode != 0:
        return None
    choice = res.stdout.strip()
    for n in notes:
        if n.stem == choice:
            return n
    return None


def resolve_workset_note(name: str | None, *, archived: bool = False, interactive: bool = False) -> Path:
    if name:
        norm = convert_to_workset_name(name)
        for n in _iter_workset_notes(archived=archived):
            if n.stem == norm:
                return n
        raise FileNotFoundError(f"Workset '{norm}' does not exist.")

    ctx = get_workset_context()
    if ctx and ctx[1]:
        matches = find_matching_worksets(ctx[0], ctx[1], archived=archived)
        if len(matches) == 1:
            return matches[0]
        if len(matches) > 1:
            names = ", ".join(m.stem for m in matches)
            raise ValueError(f"Multiple worksets match '{ctx[1]}': {names}. Pass the workset name explicitly.")

    if interactive:
        picked = _select_workset_with_fzf(archived=archived)
        if picked is not None:
            return picked

    raise ValueError("Specify a workset name or run from inside a repository branch with an existing workset.")


def _find_repo_dir_by_name(repo_name: str, metadata: dict) -> Path | None:
    for repo in metadata.get("repositories") or []:
        if isinstance(repo, dict):
            r_root = repo.get("root")
            if r_root and Path(r_root).name == repo_name and Path(r_root).is_dir():
                return Path(r_root)
    origin_root = metadata.get("originRoot")
    if origin_root and Path(origin_root).name == repo_name and Path(origin_root).is_dir():
        return Path(origin_root)
    roots_file = resolve_project_roots_file()
    for raw_root in read_config_lines(roots_file):
        base = Path(os.path.expandvars(raw_root)).expanduser()
        if not base.is_dir():
            continue
        direct = base / repo_name
        if (direct / ".git").exists():
            return direct
        try:
            for child in base.iterdir():
                cand = child / repo_name
                if child.is_dir() and (cand / ".git").exists():
                    return cand
        except OSError:
            continue
    return None


def _encode_workset_path(full_path: Path, repo_root: str | None) -> str:
    if repo_root:
        root_p = Path(repo_root).resolve()
        try:
            rel = full_path.resolve().relative_to(root_p)
            return f"{root_p.name}/{rel.as_posix()}"
        except ValueError:
            pass
    return str(full_path.resolve())


def _decode_workset_path(raw_line: str, metadata: dict) -> Path:
    p = Path(raw_line)
    if p.is_absolute():
        return p
    parts = raw_line.split("/", 1)
    if len(parts) == 2:
        repo_name, rel = parts
        repo_dir = _find_repo_dir_by_name(repo_name, metadata)
        if repo_dir is not None:
            return repo_dir / rel
    raise ValueError(f"Could not resolve relative workset path '{raw_line}'.")


def read_workset_files(note_path: Path) -> tuple[dict, str, list[Path]]:
    text = note_path.read_text(encoding="utf-8", errors="replace")
    metadata, body = _parse_frontmatter(text)
    entries = _extract_files_section(body)
    files: list[Path] = []
    seen: set[str] = set()
    for line in entries:
        p = _decode_workset_path(line, metadata)
        if not p.is_file():
            raise FileNotFoundError(f"Workset file not found: {line}")
        resolved = p.resolve()
        key = str(resolved)
        if key not in seen:
            seen.add(key)
            files.append(resolved)
    return metadata, body, files


def discover_vs_solutions(root: Path, max_depth: int = 3) -> list[Path]:
    skip = {".git", "node_modules", "bin", "obj", ".vs", "packages"}
    found: list[Path] = []

    def _walk(cur: Path, depth: int) -> None:
        try:
            entries = sorted(cur.iterdir(), key=lambda p: p.name.lower())
        except OSError:
            return
        for entry in entries:
            if entry.is_file() and entry.suffix.lower() in (".sln", ".slnx"):
                found.append(entry)
            elif entry.is_dir() and not entry.is_symlink() and entry.name not in skip and depth < max_depth:
                _walk(entry, depth + 1)

    _walk(root, 0)
    return found


def resolve_vs_devenv() -> str | None:
    found = shutil.which("devenv.exe") or shutil.which("devenv")
    if found:
        return found
    vswhere = Path("/mnt/c/Program Files (x86)/Microsoft Visual Studio/Installer/vswhere.exe")
    if vswhere.is_file():
        res = subprocess.run(
            [str(vswhere), "-latest", "-products", "*", "-property", "productPath"],
            capture_output=True,
            text=True,
            check=False,
        )
        win_path = res.stdout.strip().splitlines()[0].strip() if res.returncode == 0 and res.stdout.strip() else ""
        if win_path:
            wsl_res = subprocess.run(["wslpath", "-u", win_path], capture_output=True, text=True, check=False)
            cand = wsl_res.stdout.strip()
            if wsl_res.returncode == 0 and cand and Path(cand).is_file():
                return cand
    return None


def to_windows_path(path: Path) -> str:
    if shutil.which("wslpath"):
        res = subprocess.run(["wslpath", "-w", str(path)], capture_output=True, text=True, check=False)
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()
    return str(path)


def _parse_workset_and_files(
    item: str | None,
    extra_paths: list[str],
    files_flag: list[str] | None,
    usage: str,
) -> tuple[str | None, list[str]]:
    raw_inputs: list[str] = []
    ws_name: str | None = None
    existing_names = {n.stem for n in _iter_workset_notes(archived=False)}

    def _is_file_token(token: str) -> bool:
        if Path(token).is_file():
            return True
        try:
            norm = convert_to_workset_name(token)
        except ValueError:
            norm = ""
        return ("/" in token or "\\" in token) and norm not in existing_names

    if files_flag:
        raw_inputs.extend(files_flag)
        if item:
            if _is_file_token(item):
                raw_inputs.append(item)
            else:
                ws_name = item
        raw_inputs.extend(extra_paths)
    elif extra_paths:
        if item and _is_file_token(item):
            raw_inputs.append(item)
        else:
            ws_name = item
        raw_inputs.extend(extra_paths)
    elif item:
        raw_inputs.append(item)
    else:
        raise ValueError(usage)
    return ws_name, raw_inputs


def _remote_to_https_url(remote: str) -> str:
    s = remote.strip()
    if s.startswith("git@") and ":" in s:
        host_user, path = s.split(":", 1)
        host = host_user.split("@", 1)[1]
        s = f"https://{host}/{path}"
    if s.endswith(".git"):
        s = s[:-4]
    return s


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="workset",
        description="Manage named cross-repository issue file sets backed by Obsidian markdown notes.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Actions:\n"
            "  list [--archived]                  List active or archived worksets (default)\n"
            "  new [<name>] [--url U] [--project P] [--status S]\n"
            "                                     Create workset note in vault (defaults to current branch)\n"
            "  add [<name>] <file>...             Add files to current or named workset\n"
            "  rm [<name>] <file>...              Remove files from current or named workset\n"
            "  show [<name>] [--archived]         Print workset note\n"
            "  edit [<name>]                      Open workset note in editor\n"
            "  open [<name>] [--code|--vs]        Open workset (splits VS/.NET & VS Code by default)\n"
            "  gh [<name>]                        Open workset issue_url (or repo remote) in Brave\n"
            "  archive [<name>]                   Move active workset to archived\n"
            "  restore [<name>]                   Restore archived workset to active\n"
            "  delete [<name>] [--archived]       Remove a workset permanently\n"
        ),
    )
    parser.add_argument("tokens", nargs="*", help="Action and arguments")
    parser.add_argument("-f", "--files", nargs="+", dest="files_flag", help="Files to add/remove (on 'add'/'rm')")
    parser.add_argument("--url", help="Issue URL for 'new'")
    parser.add_argument("--project", help="Parent [[Project]] wikilink for 'new'")
    parser.add_argument("--status", help="Initial status for 'new'")
    parser.add_argument("--code", action="store_true", help="Open all workset files in VS Code ('open' only)")
    parser.add_argument("--vs", action="store_true", help="Force Visual Studio ('open' only)")
    parser.add_argument("--archived", action="store_true", help="Target archived worksets (list/show/delete)")
    parser.add_argument("--what-if", action="store_true", help="Preview mutating or launch actions without executing")
    parser.add_argument("--current-name", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--prompt-badge", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--root", help=argparse.SUPPRESS)
    parser.add_argument("--branch", help=argparse.SUPPRESS)
    return parser


def main(argv: list[str] | None = None) -> int:
    raw = sys.argv[1:] if argv is None else argv
    args = build_parser().parse_args(normalize_legacy_flags(raw))

    if args.current_name:
        name = get_current_workset_name(args.root or "", args.branch or "")
        if name:
            print(name)
        return 0

    if args.prompt_badge:
        badge = get_current_workset_badge(args.root or "", args.branch or "")
        if badge:
            print(badge)
        return 0

    tokens = list(args.tokens)
    if not tokens:
        action = "list"
        rest: list[str] = []
    elif tokens[0].lower() in VALID_ACTIONS:
        action = tokens[0].lower()
        rest = tokens[1:]
    else:
        print(ctext(f"Unknown action '{tokens[0]}'. Expected one of: {', '.join(VALID_ACTIONS)}", "red"), file=sys.stderr)
        return 2

    if args.code and args.vs:
        print(ctext("Choose either --code or --vs.", "red"), file=sys.stderr)
        return 2
    if (args.code or args.vs) and action != "open":
        print(ctext("--code and --vs are only valid with 'open'.", "red"), file=sys.stderr)
        return 2
    if args.files_flag and action not in ("add", "rm"):
        print(ctext("--files is only valid with 'add' or 'rm'.", "red"), file=sys.stderr)
        return 2
    if args.archived and action not in ("list", "show", "delete"):
        print(ctext("--archived is only valid with 'list', 'show', or 'delete'.", "red"), file=sys.stderr)
        return 2

    item = rest[0] if rest else None
    extra_paths = rest[1:] if len(rest) > 1 else []

    if action not in ("add", "rm") and extra_paths:
        print(ctext(f"Unexpected arguments: {', '.join(extra_paths)}", "red"), file=sys.stderr)
        return 2

    try:
        if action == "list":
            for note in _iter_workset_notes(archived=args.archived):
                print(note.stem)
            return 0

        if action == "new":
            _rig_root, _ws, _vault, cfg = _workset_env()
            ctx = get_workset_context()
            if not item:
                if not ctx or not ctx[1]:
                    raise ValueError("A workset name is required outside a repository or on detached HEAD.")
                item = ctx[1]
            name = convert_to_workset_name(item)

            if args.project:
                parent_note = args.project.strip()
            elif cfg.get("parent_mode") == "repo" and ctx:
                parent_note = Path(ctx[0]).name
            else:
                parent_note = str(cfg.get("parent_note") or "Worksets")

            active_note = _target_note_path(name, parent_note=parent_note, archived=False)
            archived_note = _target_note_path(name, parent_note=parent_note, archived=True)
            existing = {n.stem for n in (*_iter_workset_notes(archived=False), *_iter_workset_notes(archived=True))}
            if name in existing or active_note.exists() or archived_note.exists():
                raise ValueError(f"Workset '{name}' already exists, including archived worksets.")

            status = args.status or str(cfg.get("default_status") or "wip")
            issue_url = (args.url or "").strip()

            if args.what_if:
                print(ctext(f"WHAT-IF: Create workset '{name}' at {active_note}", "cyan"))
                return 0

            active_note.parent.mkdir(parents=True, exist_ok=True)
            staging = active_note.parent / f".new-{uuid.uuid4().hex}.md"
            try:
                content = _render_workset_note(
                    name,
                    parent_note=parent_note,
                    status=status,
                    issue_url=issue_url,
                    origin_root=ctx[0] if ctx else None,
                    branch=ctx[1] if ctx else None,
                    repositories=[],
                    files=[],
                )
                staging.write_text(content, encoding="utf-8", newline="\n")
                os.replace(staging, active_note)
            finally:
                if staging.exists():
                    staging.unlink(missing_ok=True)
            print(ctext(f"✓ Created workset '{name}' -> {active_note}", "green"))
            return 0

        if action == "add":
            ws_name, raw_inputs = _parse_workset_and_files(
                item,
                extra_paths,
                args.files_flag,
                "Usage: workset add [<name>] <file>... | workset add [<name>] --files <file>...",
            )

            note_path = resolve_workset_note(ws_name)
            text = note_path.read_text(encoding="utf-8", errors="replace")
            metadata, body = _parse_frontmatter(text)
            existing = _extract_files_section(body)
            added: list[str] = []
            repositories: list[dict] = list(metadata.get("repositories") or [])
            known_roots = {r.get("root") for r in repositories if isinstance(r, dict)}

            for f_raw in raw_inputs:
                p = Path(f_raw).expanduser()
                if not p.is_file():
                    raise FileNotFoundError(f"File not found: {f_raw}")
                resolved_p = p.resolve()
                ctx = get_workset_context(resolved_p.parent)
                if ctx and ctx[1] and ctx[0] not in known_roots:
                    repositories.append({"root": ctx[0], "name": Path(ctx[0]).name, "branch": ctx[1]})
                    known_roots.add(ctx[0])
                entry_str = _encode_workset_path(resolved_p, ctx[0] if ctx else None)
                if entry_str not in existing and str(resolved_p) not in existing and entry_str not in added:
                    added.append(entry_str)

            if added:
                if args.what_if:
                    print(ctext(f"WHAT-IF: Add {len(added)} file(s) to '{note_path.stem}'", "cyan"))
                    return 0
                metadata["repositories"] = repositories
                new_body = _replace_files_section(body, [*existing, *added])
                note_path.write_text(_dump_frontmatter(metadata) + "\n" + new_body, encoding="utf-8", newline="\n")
                print(ctext(f"✓ Added {len(added)} file(s) to '{note_path.stem}'.", "green"))
            return 0

        if action == "rm":
            ws_name, raw_inputs = _parse_workset_and_files(
                item,
                extra_paths,
                args.files_flag,
                "Usage: workset rm [<name>] <file>... | workset rm [<name>] --files <file>...",
            )
            note_path = resolve_workset_note(ws_name)
            text = note_path.read_text(encoding="utf-8", errors="replace")
            metadata, body = _parse_frontmatter(text)
            existing = _extract_files_section(body)

            targets: set[str] = set()
            for f_raw in raw_inputs:
                targets.add(f_raw.strip())
                p = Path(f_raw).expanduser()
                if p.exists():
                    rp = p.resolve()
                    targets.add(str(rp))
                    ctx = get_workset_context(rp.parent)
                    if ctx:
                        targets.add(_encode_workset_path(rp, ctx[0]))

            kept: list[str] = []
            removed = 0
            for s in existing:
                matched = s in targets
                if not matched:
                    try:
                        decoded = str(_decode_workset_path(s, metadata).resolve())
                        matched = decoded in targets
                    except (ValueError, OSError):
                        matched = False
                if matched:
                    removed += 1
                else:
                    kept.append(s)

            if args.what_if:
                print(ctext(f"WHAT-IF: Remove {removed} file(s) from '{note_path.stem}'", "cyan"))
                return 0
            if removed:
                new_body = _replace_files_section(body, kept)
                note_path.write_text(_dump_frontmatter(metadata) + "\n" + new_body, encoding="utf-8", newline="\n")
                print(ctext(f"✓ Removed {removed} file(s) from '{note_path.stem}'.", "green"))
            else:
                print(ctext("No matching files found in workset.", "yellow"))
            return 0

        if action == "show":
            note_path = resolve_workset_note(item, archived=args.archived, interactive=True)
            print(f"\n{ctext('Workset:', 'cyan')} {ctext(note_path.stem, 'white')} ({note_path})")
            content = note_path.read_text(encoding="utf-8", errors="replace")
            if content:
                print(content.rstrip())
            return 0

        if action == "edit":
            note_path = resolve_workset_note(item)
            editor_cmd = os.environ.get("VISUAL") or os.environ.get("EDITOR")
            if args.what_if:
                print(ctext(f"WHAT-IF: Edit {note_path}", "cyan"))
                return 0
            if shutil.which("code"):
                proc = subprocess.run(["code", "--wait", str(note_path)])
                return proc.returncode
            if editor_cmd:
                proc = subprocess.run([*editor_cmd.split(), str(note_path)])
                return proc.returncode
            raise FileNotFoundError("No editor found (install VS Code 'code' or set VISUAL/EDITOR).")

        if action == "gh":
            note_path = resolve_workset_note(item, interactive=True)
            metadata, _ = _parse_frontmatter(note_path.read_text(encoding="utf-8", errors="replace"))
            url = str(metadata.get("issue_url") or "").strip()
            if not url:
                origin_root = metadata.get("originRoot")
                if origin_root and Path(origin_root).is_dir():
                    remote_res = run_git(["remote", "get-url", "origin"], cwd=Path(origin_root))
                    if remote_res.returncode == 0 and remote_res.stdout.strip():
                        url = _remote_to_https_url(remote_res.stdout.strip())
            if not url:
                raise ValueError(f"Workset '{note_path.stem}' has no 'issue_url' and no git origin remote.")
            if args.what_if:
                print(ctext(f"WHAT-IF: Open {url} in brave", "cyan"))
                return 0
            browser = shutil.which("brave") or shutil.which("brave-browser") or shutil.which("xdg-open")
            if not browser:
                raise FileNotFoundError("No browser found ('brave', 'brave-browser', or 'xdg-open').")
            subprocess.Popen([browser, url], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(ctext(f"✓ Opened {url}", "green"))
            return 0

        if action == "open":
            note_path = resolve_workset_note(item, interactive=True)
            metadata, _body, files = read_workset_files(note_path)
            if not files:
                raise ValueError("The workset has no files.")

            roots: list[str] = []
            grouped: dict[str, list[Path]] = {}
            all_in_repos = True
            for fp in files:
                ctx = get_workset_context(fp.parent)
                if ctx:
                    r_str = ctx[0]
                else:
                    all_in_repos = False
                    r_str = str(fp.parent)
                if r_str not in roots:
                    roots.append(r_str)
                grouped.setdefault(r_str, []).append(fp)

            for repo in metadata.get("repositories") or []:
                r_root = repo.get("root")
                if not r_root or r_root not in roots:
                    continue
                if not Path(r_root).is_dir():
                    print(ctext(f"WARNING: Recorded repository is missing: {r_root}", "yellow"), file=sys.stderr)
                    continue
                cur = get_workset_context(Path(r_root))
                cur_branch = cur[1] if cur else None
                if not cur or cur_branch != repo.get("branch"):
                    print(
                        ctext(
                            f"WARNING: Branch mismatch in '{r_root}': expected '{repo.get('branch')}', current '{cur_branch}'.",
                            "yellow",
                        ),
                        file=sys.stderr,
                    )

            if args.what_if:
                print(ctext(f"WHAT-IF: Open workset '{note_path.stem}' in VS Code ({len(files)} file(s))", "cyan"))
                return 0
            code_bin = shutil.which("code")
            if not code_bin:
                raise FileNotFoundError("✖ workset: VS Code command ('code') not found in PATH.")
            cmd = [code_bin, "--new-window", *roots]
            if files:
                cmd.extend(["-g", *(str(f) for f in files)])
            proc = subprocess.run(cmd)
            return proc.returncode

        if action == "archive":
            note_path = resolve_workset_note(item, archived=False)
            dest = _archived_counterpart(note_path, to_archived=True)
            if dest.exists():
                raise ValueError(f"Archive already exists: {dest}")
            if args.what_if:
                print(ctext(f"WHAT-IF: Archive workset '{note_path.stem}' -> {dest}", "cyan"))
                return 0
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(note_path), str(dest))
            print(ctext(f"✓ Archived workset '{note_path.stem}'.", "green"))
            return 0

        if action == "restore":
            note_path = resolve_workset_note(item, archived=True)
            dest = _archived_counterpart(note_path, to_archived=False)
            if dest.exists():
                raise ValueError(f"Active workset already exists: {dest}")
            if args.what_if:
                print(ctext(f"WHAT-IF: Restore workset '{note_path.stem}' -> {dest}", "cyan"))
                return 0
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(note_path), str(dest))
            print(ctext(f"✓ Restored workset '{note_path.stem}'.", "green"))
            return 0

        if action == "delete":
            note_path = resolve_workset_note(item, archived=args.archived)
            if args.what_if:
                print(ctext(f"WHAT-IF: Delete workset '{note_path.stem}'", "cyan"))
                return 0
            note_path.unlink()
            print(ctext(f"✓ Deleted workset '{note_path.stem}'.", "green"))
            return 0

    except (ValueError, FileNotFoundError) as exc:
        print(ctext(str(exc), "red"), file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
